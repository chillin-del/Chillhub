local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(connections, c)
    return c
end

local function getHumanoid()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function copy(text)
    if type(setclipboard) == "function" then
        setclipboard(text)
        return true
    end
    return false
end

local function findChild(parent, ...)
    local node = parent
    for _, name in ipairs({...}) do
        if not node then return nil end
        node = node:FindFirstChild(name)
    end
    return node
end

local noclipSaved = {}
local savedJump = nil

local function setNoclip(on)
    local character = LocalPlayer.Character
    if not character then return end
    if on then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if noclipSaved[part] == nil then
                    noclipSaved[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    else
        for part, canCollide in pairs(noclipSaved) do
            if part.Parent then
                pcall(function() part.CanCollide = canCollide end)
            end
        end
        noclipSaved = {}
    end
end

local function setJump(on)
    local hum = getHumanoid()
    if not hum then return end
    if on then
        if not savedJump then
            savedJump = { Power = hum.JumpPower, Height = hum.JumpHeight, UsePower = hum.UseJumpPower }
        end
        hum.UseJumpPower = true
        hum.JumpPower = tonumber(Options.Game_JumpPower and Options.Game_JumpPower.Value) or 50
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    elseif savedJump then
        hum.UseJumpPower = savedJump.UsePower
        hum.JumpPower = savedJump.Power
        hum.JumpHeight = savedJump.Height
        savedJump = nil
    end
end

