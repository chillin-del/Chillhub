    local function getRoundUI()
        return findChild(LocalPlayer, "PlayerGui", "MainGui", "RoundUI")
    end

    -- Same colour source IconLoop uses, so resetting never leaves a wrong tint.
    local function resetAbilityTints()
        local round = getRoundUI()
        local folder = round and findChild(round, "PlayerUI", "Abilities", "Folder")
        if not folder then
            return
        end

        for _, element in ipairs(folder:GetChildren()) do
            if element:IsA("ImageButton") then
                local icon = element:FindFirstChild("Icon")
                if icon and icon:IsA("ImageLabel") then
                    local original = element:GetAttribute("OriginalColor")
                    icon.ImageColor3 = typeof(original) == "Color3" and original or Color3.new(1, 1, 1)
                end
            end
        end
    end

    local function clearBlindnessBlur()
        for _, child in ipairs(Lighting:GetChildren()) do
            if child.Name == "BlindnessBlur" then
                child:Destroy()
            end
        end
    end

    local function clearDetectionHighlights()
        local character = LocalPlayer.Character
        if not character then
            return
        end

        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Highlight")
                and (child.Name == "DetectionHighlight" or child.Name == "OverridableDetectionHighlight") then
                child:Destroy()
            end
        end
    end

    -- Music.Muffle is cloned into the killer's Animations.ChaseTheme Sound.
    local function clearMuffle()
        local teams = findChild(workspace, "GameAssets", "Teams")
        if not teams then
            return
        end

        for _, character in ipairs(teams:GetChildren()) do
            local animations = character:FindFirstChild("Animations")
            local theme = animations and animations:FindFirstChild("ChaseTheme")
            local muffle = theme and theme:FindFirstChild("Muffle")
            if muffle and muffle:IsA("Sound") then
                muffle.Volume = 0
            end
        end
    end

    -- The Dazed remote tints the ability icons for 6 seconds even after the
    -- attribute is cleared, so remember when it fired.
    local dazeFlashUntil = 0
    local remoteEvents = findChild(ReplicatedStorage, "Events", "RemoteEvents")
    local dazedRemote = remoteEvents and remoteEvents:FindFirstChild("Dazed")
    if dazedRemote then
        connect(dazedRemote.OnClientEvent, function()
            dazeFlashUntil = os.clock() + 6.5
        end)
    end

    -- The game already ships accessibility switches that disable the heavy hit
    -- colour correction, the transition flash and camera shake.
    local savedEpilepsy = nil
    local savedCameraShake = nil

    local function applyFlashSettings(on)
        local settings = findChild(LocalPlayer, "Stats", "Settings")
        if not settings then
            return false
        end

        local epilepsy = settings:FindFirstChild("Epilepsy")
        local cameraShake = settings:FindFirstChild("CameraShake")

        if on then
            if epilepsy and epilepsy:IsA("BoolValue") then
                if savedEpilepsy == nil then
                    savedEpilepsy = epilepsy.Value
                end
                epilepsy.Value = true
            end
            if cameraShake and cameraShake:IsA("BoolValue") then
                if savedCameraShake == nil then
                    savedCameraShake = cameraShake.Value
                end
                cameraShake.Value = false
            end
        else
            if epilepsy and epilepsy:IsA("BoolValue") and savedEpilepsy ~= nil then
                epilepsy.Value = savedEpilepsy
            end
            if cameraShake and cameraShake:IsA("BoolValue") and savedCameraShake ~= nil then
                cameraShake.Value = savedCameraShake
            end
            savedEpilepsy = nil
            savedCameraShake = nil
        end

        return true
    end

    connect(Lighting.ChildAdded, function(child)
        if child.Name == "BlindnessBlur"
            and Toggles.Game_AntiBlind and Toggles.Game_AntiBlind.Value then
            task.defer(function()
                if child.Parent then
                    child:Destroy()
                end
            end)
        end
    end)

    connect(RunService.RenderStepped, function()
        if unloaded then
            return
        end

        local character = LocalPlayer.Character
        if not character then
            return
        end

        -- Pie: overlay, ability tint, hidden cooldowns and the "???" stamina
        -- counter are all rebuilt from PieBlindness every frame.
        if Toggles.Game_AntiPie.Value and character:GetAttribute("PieBlindness") then
            character:SetAttribute("PieBlindness", false)
        end

        if Toggles.Game_AntiBlind.Value then
            local blindness = character:GetAttribute("Blindness")
            if type(blindness) == "number" and blindness > 0 then
                character:SetAttribute("Blindness", 0)
            end
            clearBlindnessBlur()
        end

        local wasDazed = false
        if Toggles.Game_AntiDaze.Value then
            wasDazed = character:GetAttribute("Dazed") == true
            if wasDazed then
                character:SetAttribute("Dazed", false)
            end

            local model = character:FindFirstChild("DazedModel")
            if model then
                model:Destroy()
            end
        end

        if Toggles.Game_AntiSlow.Value then
            local modifier = character:GetAttribute("WalkSpeedModifier")
            if type(modifier) == "number" and modifier < 0 then
                character:SetAttribute("WalkSpeedModifier", 0)
            end
        end

        if Toggles.Game_AntiHighlight.Value then
            clearDetectionHighlights()
        end

        local stunned = character:GetAttribute("Stunned") == true
        if Toggles.Game_AntiMuffle.Value and stunned then
            clearMuffle()
        end

        if Toggles.Game_AntiDaze.Value and (wasDazed or os.clock() < dazeFlashUntil) then
            resetAbilityTints()
        end

        if Toggles.Game_AntiStunTint.Value and stunned then
            resetAbilityTints()
        end
    end)

    task.spawn(function()
        local applied = false

        while not unloaded and getgenv().ChillhubSimple_Gen == MY_GEN do
            local settings = findChild(LocalPlayer, "Stats", "Settings")

            if settings then
                if Toggles.Game_AntiFlash.Value then
                    if applyFlashSettings(true) then
                        applied = true
                    end
                elseif applied then
                    applyFlashSettings(false)
                    applied = false
                end
            end

            task.wait(1)
        end

        if applied then
            applyFlashSettings(false)
        end
    end)

    local StatusBox = GameTab:AddRightGroupbox("Info")
    StatusBox:AddLabel("Keeps your stamina at max")
    StatusBox:AddLabel("Sprint as long as you want")
    StatusBox:AddLabel("Works on survivor and killer")
    StatusBox:AddLabel("Rejoin-safe, auto re-applies")

    local staminaTimer = 0
    connect(RunService.Heartbeat, function(dt)
        if not Toggles.Game_InfiniteStamina.Value then return end

        keepStaminaFull()

        staminaTimer += dt
        if staminaTimer >= 0.2 and Toggles.Game_AntiExhaust.Value then
            staminaTimer = 0
            local character = LocalPlayer.Character
            if character and (character:GetAttribute("Exhausted") or 0) > 0 then
                character:SetAttribute("Exhausted", 0)
            end
        end
    end)

    connect(RunService.RenderStepped, function()
        if not Toggles.Game_InfiniteStamina.Value then return end
        if not Toggles.Game_ShowStaminaBar.Value then return end
        local bar = findChild(LocalPlayer, "PlayerGui", "MainGui", "RoundUI", "PlayerUI", "StaminaBar")
        if bar and not bar.Visible then
            bar.Visible = true
        end
    end)

    connect(RunService.RenderStepped, function()
        if not Toggles.Game_Speed.Value then return end
        local hum = getHumanoid()
        if not hum then return end
        local speed = tonumber(Options.Game_SpeedValue.Value) or 30
        if hum.WalkSpeed ~= speed then
            hum.WalkSpeed = speed
        end
    end)

    connect(RunService.RenderStepped, function()
        if Toggles.Game_Noclip.Value then
            setNoclip(true)
        end
    end)

    connect(RunService.RenderStepped, function()
        if not Toggles.Game_Jump.Value then return end
        local hum = getHumanoid()
        if not hum then return end
        local power = tonumber(Options.Game_JumpPower.Value) or 50
        hum.UseJumpPower = true
        if hum.JumpPower ~= power then
            hum.JumpPower = power
        end
        if not hum:GetStateEnabled(Enum.HumanoidStateType.Jumping) then
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        end
    end)

    connect(LocalPlayer.CharacterAdded, function()
        noclipSaved = {}
        if Toggles.Game_Noclip.Value then
            task.delay(0.5, function() setNoclip(true) end)
        end
        if Toggles.Game_Jump.Value then
            task.delay(0.5, function() setJump(true) end)
        end
    end)

    setInfiniteStamina(true)
    task.spawn(function()
        while not unloaded and getgenv().ChillhubSimple_Gen == MY_GEN do
            if Toggles.Game_InfiniteStamina.Value then
                setInfiniteStamina(true)
                keepStaminaFull()
            end
            task.wait(1)
        end
    end)
end

