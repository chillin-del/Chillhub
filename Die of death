local function getPlayerRole(player)
    if player == LocalPlayer then
        return "You"
    end

    local character = player.Character
    local teams = findChild(workspace, "GameAssets", "Teams")

    local ghostTeam = teams and teams:FindFirstChild("Ghost")
    if character and ghostTeam and character:IsDescendantOf(ghostTeam) then
        return "Ghost"
    end

    local stats = player:FindFirstChild("Stats")
    if stats then
        local isKiller = stats:FindFirstChild("IsKiller")
        if isKiller and (not isKiller:IsA("ValueBase") or isKiller.Value ~= false) then
            return "Killer"
        end
    end

    if character then
        if character:GetAttribute("KillerName") then
            return "Killer"
        end

        local killerTeam = teams and teams:FindFirstChild("Killer")
        if killerTeam and character:IsDescendantOf(killerTeam) then
            return "Killer"
        end

        local survivorTeam = teams and teams:FindFirstChild("Survivor")
        if survivorTeam and character:IsDescendantOf(survivorTeam) then
            return "Survivor"
        end

        if KILLER_CHARACTERS[character.Name] then
            return "Killer"
        end
    end

    if stats and stats:FindFirstChild("InGame") and stats.InGame.Value then
        return "Survivor"
    end

    return "Lobby"
end

local function getEquippedAbilities(character)
    local found = {}
    if not character then
        return found
    end

    local vanities = character:FindFirstChild("Vanities")
    if vanities then
        for _, obj in ipairs(vanities:GetDescendants()) do
            local id = obj:GetAttribute("VanityOf")
            local display = id and ABILITY_DISPLAY[id]
            if display then
                found[display] = true
            end
        end
    end

    return found
end

local function getAbilityText(found, character, showCooldowns)
    local parts = {}
    for _, display in ipairs(ABILITY_PRIORITY) do
        if found[display] then
            local text = display
            if showCooldowns and character then
                local ids = ABILITY_INTERNAL[display] or { display }
                local cooldown = 0
                for _, id in ipairs(ids) do
                    local value = character:GetAttribute(id .. "Cooldown")
                    if type(value) == "number" and value > cooldown then
                        cooldown = value
                    end
                end
                if cooldown > 0 then
                    text = string.format("%s (%ds)", display, math.ceil(cooldown))
                end
            end
            parts[#parts + 1] = text
        end
    end
    return table.concat(parts, ", ")
end

local function getEnabledAbilities()
    local enabled = {}
    for display, flag in pairs(ABILITY_ESP_FLAGS) do
        local toggle = Toggles[flag]
        if not toggle or toggle.Value then
            enabled[display] = true
        end
    end
    return enabled
end

local function abilityItemVisible(item)
    if item:IsA("BasePart") then
        return item.Transparency < 0.99
    end
    for _, part in ipairs(item:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency < 0.99 then
            return true
        end
    end
    return false
end

-- The game hides held ability items from other players. When a player uses
-- one, temporarily un-hide it locally so it can be seen and highlighted.
local function restoreAbilityVisibility(state, item)
    local saved = state.forcedVisibility and state.forcedVisibility[item]
    if not saved then
        return
    end
    for part, transparency in pairs(saved) do
        if part.Parent then
            part.Transparency = transparency
        end
    end
    state.forcedVisibility[item] = nil
end

local function forceAbilityVisible(state, item)
    if not state.forcedVisibility then
        state.forcedVisibility = {}
    end
    if state.forcedVisibility[item] then
        return
    end

    local saved = {}
    local function hide(part)
        if part:IsA("BasePart") then
            saved[part] = part.Transparency
            part.Transparency = 0
        end
    end

    if item:IsA("BasePart") then
        hide(item)
    else
        for _, descendant in ipairs(item:GetDescendants()) do
            hide(descendant)
        end
    end

    state.forcedVisibility[item] = saved
end

-- An ability counts as "being used" when one of its cooldowns jumps up,
-- or when the character exposes a Holding<Ability> attribute.
local function getActiveAbilities(state, character)
    local active = {}
    state.lastCooldowns = state.lastCooldowns or {}

    for display in pairs(ABILITY_MODELS) do
        local holdingName = "Holding" .. display:gsub("%s+", "")
        if character:GetAttribute(holdingName) == true then
            active[display] = true
        end

        for _, internal in ipairs(ABILITY_INTERNAL[display] or { display }) do
            local value = character:GetAttribute(internal .. "Cooldown")
            local previous = state.lastCooldowns[internal] or 0
            if type(value) == "number" then
                if value > 0.5 and value > previous + 0.75 then
                    state.usedAt = state.usedAt or {}
                    state.usedAt[display] = os.clock() + 2.2
                end
                state.lastCooldowns[internal] = value
            else
                state.lastCooldowns[internal] = 0
            end
        end
    end

    for display, expires in pairs(state.usedAt or {}) do
        if os.clock() < expires then
            active[display] = true
        else
            state.usedAt[display] = nil
        end
    end

    return active
end

local function updateAbilityHighlights(state, character, enabled, parent)
    local active = getActiveAbilities(state, character)

    -- Put back anything we un-hid once its ability is no longer being used.
    for item in pairs(state.forcedVisibility or {}) do
        local id = item.Parent and item:GetAttribute("VanityOf")
        local display = id and ABILITY_DISPLAY[id]
        if not (display and active[display] and enabled[display]) then
            restoreAbilityVisibility(state, item)
        end
    end

    local wanted = {}
    local vanities = character and character:FindFirstChild("Vanities")

    if vanities then
        for _, item in ipairs(vanities:GetChildren()) do
            local id = item:GetAttribute("VanityOf")
            local display = id and ABILITY_DISPLAY[id]
            local models = display and ABILITY_MODELS[display]

            if models and models[item.Name] and enabled[display]
                and (item:IsA("BasePart") or item:IsA("Model"))
            then
                local visible = abilityItemVisible(item)
                if active[display] or visible then
                    wanted[item] = true
                    if active[display] and not visible then
                        forceAbilityVisible(state, item)
                    end

                    local highlight = state.abilityHighlights[item]
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "AbilityESP_" .. display
                        highlight.Adornee = item
                        highlight.FillColor = ABILITY_HIGHLIGHT_COLOR
                        highlight.OutlineColor = ABILITY_HIGHLIGHT_COLOR
                        highlight.FillTransparency = 0.4
                        highlight.OutlineTransparency = 0
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = parent
                        state.abilityHighlights[item] = highlight
                    end
                end
            end
        end
    end

    for item, highlight in pairs(state.abilityHighlights) do
        if not wanted[item] or not item.Parent then
            highlight:Destroy()
            state.abilityHighlights[item] = nil
        end
    end
end

local function localHasAbility(name)
    local character = LocalPlayer.Character
    if not character then
        return false
    end

    for index = 1, 4 do
        if character:GetAttribute("Ability" .. index) == name then
            return true
        end
    end

    local folder = findChild(LocalPlayer, "PlayerGui", "MainGui", "RoundUI", "PlayerUI", "Abilities", "Folder")
    if folder and folder:FindFirstChild(name) then
        return true
    end

    local vanities = character:FindFirstChild("Vanities")
    if vanities then
        for _, obj in ipairs(vanities:GetDescendants()) do
            if obj:GetAttribute("VanityOf") == name then
                return true
            end
        end
    end

    return false
end

