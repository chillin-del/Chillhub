        Func = function()
            local h = getHumanoid()
            if h then h.Sit = true end
        end
    })

    local AnimBox = FunTab:AddRightGroupbox("Killer Animations")

    local animKeys = { "Idle", "Walk", "Sprint", "Jump", "Fall", "Land", "Sit" }
    local hurtKeys = { "HurtIdle", "HurtWalk", "HurtSprint" }
    local killerOrder = { "Pursuer", "Badware", "Killdroid", "Harken", "Artful", "Dookie Daniel", "Ghost" }
    local selectedKiller = "Default"

    local defaultAnims = {}
    do
        local clientModules = ReplicatedStorage:FindFirstChild("ClientModules")
        local characters = clientModules and clientModules:FindFirstChild("Characters")
        local civilian = characters and characters:FindFirstChild("Civilian")
        local model = civilian and (civilian:FindFirstChild("Civilian") or civilian:FindFirstChildWhichIsA("Model"))
        local animations = model and model:FindFirstChild("Animations")
        if animations then
            for _, obj in ipairs(animations:GetDescendants()) do
                if obj:IsA("Animation") then
                    defaultAnims[obj.Name] = obj.AnimationId
                end
            end
        end
    end

    local function getKillerAnimations(name)
        local clientModules = ReplicatedStorage:FindFirstChild("ClientModules")
        local characters = clientModules and clientModules:FindFirstChild("Characters")
        local character = characters and characters:FindFirstChild(name)
        if not character then return nil end
        local model = character:FindFirstChild("Default") or character:FindFirstChildWhichIsA("Model") or character
        local animations = model:FindFirstChild("Animations")
        if not animations then return nil end
        local set = {}
        for _, key in ipairs(animKeys) do
            local anim = animations:FindFirstChild(key)
            if anim and anim:IsA("Animation") then
                set[key] = anim.AnimationId
            end
        end
        return set
    end

    local function isLocomotion(name)
        return table.find(animKeys, name) ~= nil or table.find(hurtKeys, name) ~= nil
    end

    local function stopLocomotion(humanoid)
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            if isLocomotion(track.Name) then
                track:Stop(0.1)
            end
        end
    end

    local function playLocomotion(humanoid, character, name)
        local animations = character:FindFirstChild("Animations")
        local anim = animations and animations:FindFirstChild(name)
        if not anim or not anim:IsA("Animation") then return end
        for _, existing in ipairs(humanoid:GetPlayingAnimationTracks()) do
            if existing.Name == name then
                if existing.Animation and existing.Animation.AnimationId == anim.AnimationId then
                    if not existing.IsPlaying then existing:Play(0.15) end
                    return
                end
                existing:Stop(0.1)
            end
        end
        local track = humanoid:LoadAnimation(anim)
        track.Name = name
        if name == "Idle" then
            track.Priority = Enum.AnimationPriority.Core
        elseif name == "Walk" then
            track.Priority = Enum.AnimationPriority.Idle
        else
            track.Priority = Enum.AnimationPriority.Movement
        end
        track:Play(0.15)
    end

    local function applyKillerAnimations(name)
        selectedKiller = name or "Default"
        local character = LocalPlayer.Character
        local humanoid = getHumanoid()
        local animations = character and character:FindFirstChild("Animations")
        if not (character and humanoid and animations) then return end

        stopLocomotion(humanoid)

        for _, obj in ipairs(animations:GetDescendants()) do
            if obj:IsA("Animation") and defaultAnims[obj.Name] then
                obj.AnimationId = defaultAnims[obj.Name]
            end
        end

        if selectedKiller ~= "Default" then
            local set = getKillerAnimations(selectedKiller)
            if set then
                for key, id in pairs(set) do
                    local obj = animations:FindFirstChild(key)
                    if obj and obj:IsA("Animation") then
                        obj.AnimationId = id
                    end
                end
                for hurtName, baseName in pairs({ HurtIdle = "Idle", HurtWalk = "Walk", HurtSprint = "Sprint" }) do
                    local obj = animations:FindFirstChild(hurtName, true)
                    if obj and obj:IsA("Animation") and set[baseName] then
                        obj.AnimationId = set[baseName]
                    end
                end
            end
        end

        local desired = (selectedKiller ~= "Default" and humanoid.MoveDirection.Magnitude > 1) and "Walk" or "Idle"
        playLocomotion(humanoid, character, desired)
    end
    getgenv().ChillhubSetKillerAnim = applyKillerAnimations

    local killerValues = { "Default" }
    for _, name in ipairs(killerOrder) do
        local set = getKillerAnimations(name)
        if set and next(set) then
            killerValues[#killerValues + 1] = name
        end
    end

    AnimBox:AddDropdown("Fun_KillerAnim", {
        Text = "Killer Animation Set",
        Values = killerValues,
        Default = "Default",
        Callback = function(name)
            applyKillerAnimations(name)
            if name == "Default" then
                Library:Notify("Default animations restored", 3)
            else
                Library:Notify("Using " .. name .. " animations", 3)
            end
        end
    })
    AnimBox:AddLabel("Idle, walk, sprint, jump and fall")
    AnimBox:AddLabel("Local-only visual change")

    connect(LocalPlayer.CharacterAdded, function()
        if selectedKiller ~= "Default" then
            task.delay(1, function()
                applyKillerAnimations(selectedKiller)
            end)
        end
    end)
end

