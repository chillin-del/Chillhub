            local toOff = {
                "Fun_Spin", "Fun_Rainbow",
                "Fullbright_Enabled", "LowQuality_Enabled",
                "FPS_Display", "Ping_Display", "Health_Display", "Stamina_Display", "Force_HealthBar",
                "QoL_AntiAFK", "QoL_HideChat", "QoL_HidePlayerList", "QoL_JoinLeave",
                "Game_InfiniteStamina", "Game_ShowStaminaBar", "Game_AntiExhaust", "Game_Speed",
                "Game_Noclip", "Game_Jump",
                "Game_AntiPie", "Game_AntiBlind", "Game_AntiDaze", "Game_AntiSlow",
                "Game_AntiHighlight", "Game_AntiFlash", "Game_AntiMuffle", "Game_AntiStunTint",
                "ESP_Survivors", "ESP_Killers", "ESP_Abilities", "ESP_Cooldowns", "ESP_Health", "ESP_Distance",
            }
            for _, display in ipairs(ABILITY_PRIORITY) do
                local flag = ABILITY_ESP_FLAGS[display]
                if flag then toOff[#toOff + 1] = flag end
            end
            for _, name in toOff do
                local t = Toggles[name]
                if t then pcall(function() t:SetValue(false) end) end
            end
            if getgenv().ChillhubSetKillerAnim then
                pcall(getgenv().ChillhubSetKillerAnim, "Default")
            end
            if Options.Fun_KillerAnim then
                pcall(function() Options.Fun_KillerAnim:SetValue("Default") end)
            end
            Library:Notify("All features turned off", 3)
        end
    })

    MenuBox:AddButton({
        Text = "Unload Script",
        Func = function() Library:Unload() end
    })

    Library:OnUnload(function()
        unloaded = true
        for _, c in connections do pcall(function() c:Disconnect() end) end
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true) end)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true) end)
        pcall(function() setInfiniteStamina(false) end)
        pcall(function() setNoclip(false) end)
        pcall(function() setJump(false) end)
        if hudGui then pcall(function() hudGui:Destroy() end) end
        if espGui then pcall(function() espGui:Destroy() end) end
    end)

    ThemeManager:SetLibrary(Library)
    ThemeManager:SetFolder("ChillhubSimple")
    ThemeManager:ApplyTheme("Tokyo Night")
    ThemeManager:ApplyToTab(SettingsTab)

    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetFolder("ChillhubSimple")
    SaveManager:BuildConfigSection(SettingsTab)
    SaveManager:LoadAutoloadConfig()
end

