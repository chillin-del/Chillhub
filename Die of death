local MovementModule = nil
local savedInfiniteStamina = nil

local function getMovementModule()
    if MovementModule then return MovementModule end
    local movement = findChild(ReplicatedStorage, "ClientModules", "Gui", "Game", "Movement")
    if not movement then return nil end
    local ok, mod = pcall(require, movement)
    if ok and type(mod) == "table" then
        MovementModule = mod
        return mod
    end
    return nil
end

local function getInfiniteStaminaSetting()
    return findChild(ReplicatedStorage, "GameSettings", "Settings", "InfiniteStamina")
end

local function setInfiniteStamina(on)
    local setting = getInfiniteStaminaSetting()
    if not setting then return end
    if on then
        if savedInfiniteStamina == nil then
            savedInfiniteStamina = setting.Value
        end
        setting.Value = true
    else
        setting.Value = savedInfiniteStamina or false
        savedInfiniteStamina = nil
    end
end

local function keepStaminaFull()
    local character = LocalPlayer.Character
    if not character then return end
    local maxStamina = tonumber(character:GetAttribute("MaxStamina")) or 100
    local mod = getMovementModule()
    if not mod then return end
    if tonumber(mod.MaxStamina) and tonumber(mod.MaxStamina) > 0 then
        maxStamina = tonumber(mod.MaxStamina)
    end
    if maxStamina <= 0 then maxStamina = 100 end
    mod.Stamina = maxStamina
    if character:GetAttribute("Stamina") ~= maxStamina then
        character:SetAttribute("Stamina", maxStamina)
    end
end

