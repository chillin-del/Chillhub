    local espStates = {}

    local function destroyEsp(player)
        local state = espStates[player]
        if not state then
            return
        end
        if state.highlight then
            pcall(function() state.highlight:Destroy() end)
        end
        if state.billboard then
            pcall(function() state.billboard:Destroy() end)
        end
        if state.abilityHighlights then
            for _, abilityHighlight in pairs(state.abilityHighlights) do
                pcall(function() abilityHighlight:Destroy() end)
            end
        end
        if state.forcedVisibility then
            for item in pairs(state.forcedVisibility) do
                pcall(function() restoreAbilityVisibility(state, item) end)
            end
        end
        espStates[player] = nil
    end

    local function createEsp(player)
        local state = {
            abilityHighlights = {},
            forcedVisibility = {},
            lastCooldowns = {},
            usedAt = {},
        }

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_" .. player.Name
        highlight.FillTransparency = 0.7
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = espFolder

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_" .. player.Name
        billboard.Size = UDim2.fromOffset(220, 56)
        billboard.StudsOffset = Vector3.new(0, 2.8, 0)
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.MaxDistance = 2000
        billboard.ResetOnSpawn = false
        billboard.Parent = espFolder

        local function makeLabel(y, height, textSize)
            local label = Instance.new("TextLabel")
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 0, height)
            label.Position = UDim2.fromOffset(0, y)
            label.Font = Enum.Font.GothamBold
            label.TextSize = textSize
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.Parent = billboard
            return label
        end

        state.highlight   = highlight
        state.billboard   = billboard
        state.nameLabel   = makeLabel(0, 20, 15)
        state.infoLabel   = makeLabel(20, 16, 13)
        state.abilityLabel = makeLabel(36, 18, 13)
        state.abilityLabel.TextColor3 = Color3.fromRGB(255, 210, 80)

        espStates[player] = state
        return state
    end

    local espTimer = 0
    connect(RunService.Heartbeat, function(dt)
        espTimer += dt
        if espTimer < 0.2 then
            return
        end
        espTimer = 0

        local showSurvivors = Toggles.ESP_Survivors.Value
        local showKillers   = Toggles.ESP_Killers.Value
        local showAbilities = Toggles.ESP_Abilities.Value
        local showAbilityModels = Toggles.ESP_AbilityModels.Value
        local showCooldowns = Toggles.ESP_Cooldowns.Value
        local showHealth    = Toggles.ESP_Health.Value
        local showDistance  = Toggles.ESP_Distance.Value
        local maxDistance   = tonumber(Options.ESP_MaxDistance.Value) or 0
        local unlimited     = maxDistance <= 0
        local billboardDistance = unlimited and 20000 or maxDistance
        local enabledAbilities = getEnabledAbilities()

        local myRoot = getRoot()
        local myPos = myRoot and myRoot.Position

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local role = getPlayerRole(player)
                local show = (role == "Survivor" and showSurvivors) or (role == "Killer" and showKillers)

                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local distance = (myPos and root) and (root.Position - myPos).Magnitude or 0

                if show and humanoid and root and humanoid.Health > 0 and (unlimited or distance <= maxDistance) then
                    local state = espStates[player]
                    if not state or not state.highlight or not state.highlight.Parent then
                        destroyEsp(player)
                        state = createEsp(player)
                    end

                    if state.character ~= character then
                        if state.forcedVisibility then
                            for item in pairs(state.forcedVisibility) do
                                pcall(function() restoreAbilityVisibility(state, item) end)
                            end
                        end
                        state.character = character
                        state.lastCooldowns = {}
                        state.usedAt = {}
                    end

                    state.highlight.Adornee = character
                    state.billboard.Adornee = root
                    state.billboard.MaxDistance = billboardDistance

                    local isKiller = role == "Killer"
                    local color = isKiller and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(90, 255, 140)
                    state.highlight.FillColor = color
                    state.highlight.OutlineColor = color

                    state.nameLabel.Text = (isKiller and "[KILLER] " or "[SURVIVOR] ") .. player.DisplayName
                    state.nameLabel.TextColor3 = color

                    local info = {}
                    if showHealth then
                        info[#info + 1] = string.format("HP: %d/%d",
                            math.floor(humanoid.Health + 0.5),
                            math.floor(humanoid.MaxHealth + 0.5))
                    end
                    if showDistance then
                        info[#info + 1] = string.format("%dm", math.floor(distance))
                    end
                    if isKiller then
                        local killerName = character:GetAttribute("KillerName")
                        if killerName then
                            info[#info + 1] = tostring(killerName)
                        else
                            local stats = player:FindFirstChild("Stats")
                            local equipped = stats and stats:FindFirstChild("EquippedKiller")
                            if equipped and equipped.Value ~= "" then
                                info[#info + 1] = tostring(equipped.Value)
                            end
                        end
                    end
                    state.infoLabel.Text = table.concat(info, "  |  ")
                    state.infoLabel.Visible = #info > 0

                    local abilityText = ""
                    if showAbilities then
                        local found = getEquippedAbilities(character)
                        for display in pairs(found) do
                            if not enabledAbilities[display] then
                                found[display] = nil
                            end
                        end
                        abilityText = getAbilityText(found, character, showCooldowns)
                    end
                    state.abilityLabel.Text = abilityText
                    state.abilityLabel.Visible = abilityText ~= ""

                    if showAbilities and showAbilityModels then
                        updateAbilityHighlights(state, character, enabledAbilities, espFolder)
                    else
                        updateAbilityHighlights(state, character, {}, espFolder)
                    end
                else
                    destroyEsp(player)
                end
            end
        end

        for player in pairs(espStates) do
            if not player.Parent or not player.Character then
                destroyEsp(player)
            end
        end
    end)

    connect(Players.PlayerRemoving, destroyEsp)

end

