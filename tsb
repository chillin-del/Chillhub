local KORBLOX_MESH    = "rbxassetid://119249943"
local KORBLOX_TEXTURE = "rbxassetid://129458735"

local function applyKorblox(char)
    if not char then return end
    local leg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
    if not leg then return end
    for _,v in leg:GetChildren() do if v.Name=="KorbloxMesh" then v:Destroy() end end
    local mesh = Instance.new("SpecialMesh"); mesh.Name="KorbloxMesh"; mesh.MeshType=Enum.MeshType.FileMesh
    mesh.MeshId=KORBLOX_MESH; mesh.TextureId=KORBLOX_TEXTURE; mesh.Scale=Vector3.new(1,1,1); mesh.Parent=leg
end
local function removeKorblox(char)
    if not char then return end
    local leg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
    if not leg then return end
    for _,v in leg:GetChildren() do if v.Name=="KorbloxMesh" then v:Destroy() end end
end
local headlessSaved = {}
local function hideForHeadless(inst, saved)
    if not inst or not (inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture")) then return end
    if inst.Transparency>=1 then return end
    saved[#saved+1]={inst=inst,t=inst.Transparency}; inst.Transparency=1
end
local function applyHeadless(char)
    if not char or headlessSaved[char] then return end
    local saved={}
    local head=char:FindFirstChild("Head")
    if head then hideForHeadless(head,saved); for _,v in head:GetChildren() do if v:IsA("Decal") or v:IsA("Texture") then hideForHeadless(v,saved) end end end
    for _,acc in char:GetChildren() do
        if acc:IsA("Accessory") then
            local t=acc.AccessoryType
            if t==Enum.AccessoryType.Hat or t==Enum.AccessoryType.Hair or t==Enum.AccessoryType.Face
                or t==Enum.AccessoryType.Eyebrow or t==Enum.AccessoryType.Eyelash then
                hideForHeadless(acc:FindFirstChild("Handle"),saved)
            end
        end
    end
    headlessSaved[char]=saved
end
local function removeHeadless(char)
    if not char then return end
    local saved=headlessSaved[char]; if not saved then return end
    for _,e in ipairs(saved) do if e.inst and e.inst.Parent then e.inst.Transparency=e.t end end
    headlessSaved[char]=nil
end
local function refreshCosmetics()
    local char=LocalPlayer.Character
    if Flags.Appearance_Korblox then applyKorblox(char) else removeKorblox(char) end
    if Flags.Appearance_Headless then applyHeadless(char) else removeHeadless(char) end
end
connect(LocalPlayer.CharacterAdded, function(char)
    task.wait(0.6)
    if Flags.Appearance_Korblox then applyKorblox(char) end
    if Flags.Appearance_Headless then applyHeadless(char) end
end)

