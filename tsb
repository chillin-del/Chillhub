-- FLING TAB
------------------------------------------------------------
do
    local FlingBox = addGroup(FlingTab,"Left","Fling Tool","tornado")
    FlingBox:AddDropdown("Fling_Target", { SpecialType="Player", ExcludeLocalPlayer=true, Text="Fling Target" })
    FlingBox:AddSlider("Fling_Power",    { Text="Fling Power", Min=1000, Max=300000, Default=60000, Rounding=0 })
    FlingBox:AddSlider("Fling_Duration", { Text="Fling Time",  Min=300,  Max=4000,   Default=1500,  Rounding=0, Suffix="ms" })
    FlingBox:AddToggle("Fling_ReturnBack",{ Text="Return To My Spot After", Default=true })
    local function flingTargetTorso(plr)
        local char=plr.Character; if not char then return nil end
        local t=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
        local h=char:FindFirstChildOfClass("Humanoid")
        if t and h and h.Health>0 then return t end; return nil
    end
    local function flingPlayer(target)
        if Shared.flinging then return end
        local root=getRoot(); local hum=getHumanoid(); local tRoot=target and flingTargetTorso(target)
        if not root or not hum or not tRoot then Library:Notify("Can't fling — target not alive",3); return end
        Shared.flinging=true; Shared.restoreNoclip()
        local origin=root.CFrame; local power=Options.Fling_Power.Value; local duration=Options.Fling_Duration.Value/1000; local start=os.clock()
        Library:Notify("Flinging "..playerLabel(target).."...",2)
        task.spawn(function()
            pcall(function()
                hum.PlatformStand=true
                while os.clock()-start<duration do
                    local r=getRoot(); local tr=flingTargetTorso(target)
                    if not r or not tr then break end
                    r.CFrame=tr.CFrame; r.AssemblyAngularVelocity=Vector3.new(0,power,0); r.AssemblyLinearVelocity=Vector3.new(power,power,power)
                    RunService.Heartbeat:Wait()
                end
            end)
            local r=getRoot()
            if r then r.AssemblyAngularVelocity=Vector3.zero; r.AssemblyLinearVelocity=Vector3.zero; if Toggles.Fling_ReturnBack.Value then r.CFrame=origin end end
            local h2=getHumanoid(); if h2 then h2.PlatformStand=false; h2:ChangeState(Enum.HumanoidStateType.GettingUp) end
            Shared.flinging=false
        end)
    end
    FlingBox:AddButton({ Text="Fling Target", Func=function() flingPlayer(resolvePlayer(Options.Fling_Target.Value)) end })
    local AuraBox=addGroup(FlingTab,"Right","Fling Aura & Touch Fling","zap")
    AuraBox:AddToggle("FlingAura_Enabled", { Text="Fling Aura",   Default=false })
    AuraBox:AddSlider("FlingAura_Radius",  { Text="Fling Aura Radius", Min=5, Max=100, Default=15, Rounding=0, Suffix=" studs" })
    AuraBox:AddToggle("TouchFling_Enabled",{ Text="Touch Fling",  Default=false })
    connect(RunService.Heartbeat,function()
        if not Toggles.TouchFling_Enabled or not Toggles.TouchFling_Enabled.Value then return end
        local r=getRoot(); if r then local vel=r.AssemblyLinearVelocity; r.AssemblyLinearVelocity=Vector3.new(0,9999,0); RunService.RenderStepped:Wait(); r.AssemblyLinearVelocity=vel end
    end)
    local flingAuraCDs={}
    connect(RunService.Heartbeat,function()
        if not Toggles.FlingAura_Enabled.Value or Shared.flinging then return end
        local myRoot=getRoot(); if not myRoot then return end
        local radius=Options.FlingAura_Radius.Value; local now=os.clock()
        for _,plr in Players:GetPlayers() do
            if plr~=LocalPlayer then
                local root=flingTargetTorso(plr)
                if root and (root.Position-myRoot.Position).Magnitude<=radius then
                    if not flingAuraCDs[plr] or now-flingAuraCDs[plr]>2 then flingAuraCDs[plr]=now; flingPlayer(plr); break end
