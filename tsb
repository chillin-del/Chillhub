    local PLAT_THICK=4; local WALL_H=60; local safezone=nil; local lastHealth=nil; local healthConn=nil
    local function makePart(cont,name,size,cf,trans) local p=Instance.new("Part"); p.Name=name; p.Anchored=true; p.CanCollide=true; p.CastShadow=false; p.Material=Enum.Material.ForceField; p.Color=ACCENT; p.Transparency=trans; p.Size=size; p.CFrame=cf; p.Parent=cont; return p end
    local function destroySafezone() if safezone then local d=safezone; safezone=nil; if d.container then d.container:Destroy() end end end
    local function leaveSafezone()
        if not safezone then return end
        local d=safezone; destroySafezone()
        local root=getRoot()
        if root and d.returnCFrame then root.AssemblyLinearVelocity=Vector3.zero; root.CFrame=d.returnCFrame end
    end
    local function enterSafezone()
        if safezone then return end; local root=getRoot(); if not root then return end
        local retCF=root.CFrame; local sz=Options.Combat_Safezone_Size.Value
        local center=retCF.Position+Vector3.new(0,Options.Combat_Safezone_Height.Value,0)
        local cont=Instance.new("Folder"); cont.Name="ChillSafezone"
        makePart(cont,"Platform",Vector3.new(sz,PLAT_THICK,sz),CFrame.new(center),0.5)
        if Toggles.Combat_Safezone_Walls.Value then
            local half=sz/2; local wc=center+Vector3.new(0,PLAT_THICK/2+WALL_H/2,0)
            makePart(cont,"WallN",Vector3.new(sz,WALL_H,2),CFrame.new(wc+Vector3.new(0,0,half)),0.9)
            makePart(cont,"WallS",Vector3.new(sz,WALL_H,2),CFrame.new(wc-Vector3.new(0,0,half)),0.9)
            makePart(cont,"WallE",Vector3.new(2,WALL_H,sz),CFrame.new(wc+Vector3.new(half,0,0)),0.9)
            makePart(cont,"WallW",Vector3.new(2,WALL_H,sz),CFrame.new(wc-Vector3.new(half,0,0)),0.9)
        end
        cont.Parent=workspace
        safezone={container=cont,center=center,size=sz,returnCFrame=retCF}
        root.AssemblyLinearVelocity=Vector3.zero; root.CFrame=CFrame.new(center+Vector3.new(0,PLAT_THICK/2+4,0))
        Library:Notify("Safezone activated",3)
        local delay=Options.Combat_Safezone_ReturnTime.Value
        if delay>0 then task.delay(delay,function() if safezone then leaveSafezone() end end) end
    end
    connect(RunService.Heartbeat,function()
        local d=safezone; if not d then return end; local root=getRoot(); if not root then return end
        local rel=root.Position-d.center; local lim=d.size/2+4
        if rel.Y<-8 or math.abs(rel.X)>lim or math.abs(rel.Z)>lim then root.AssemblyLinearVelocity=Vector3.zero; root.CFrame=CFrame.new(d.center+Vector3.new(0,PLAT_THICK/2+4,0)) end
    end)
    local function watchChar(char)
        local hum=char:WaitForChild("Humanoid",10); if not hum then return end
        if healthConn then healthConn:Disconnect() end
        lastHealth=hum.Health
        healthConn=hum.HealthChanged:Connect(function(health)
            local took=lastHealth~=nil and health<lastHealth; lastHealth=health
            if not took or health<=0 then return end
            if not Toggles.Combat_Safezone_Enabled.Value or safezone then return end
            if health<=hum.MaxHealth*(Options.Combat_Safezone_Health.Value/100) then enterSafezone() end
        end)
    end
    SafeControls:AddButton({ Text="Go To Safezone Now", Func=enterSafezone })
    SafeControls:AddButton({ Text="Return To Ground",    Func=leaveSafezone })
    SafeControls:AddLabel({ Text="Safezone key set in Home tab (default N).", DoesWrap=true })
    connect(UserInputService.InputBegan,function(input,processed)
        if processed then return end
        local key=keyFromOption("Combat_Safezone_Key")
        if key and input.KeyCode==key then if safezone then leaveSafezone() else enterSafezone() end end
    end)
    connect(LocalPlayer.CharacterAdded,function(char) destroySafezone(); watchChar(char) end)
    if LocalPlayer.Character then task.spawn(watchChar,LocalPlayer.Character) end
    onCleanup(function() if healthConn then healthConn:Disconnect() end; destroySafezone() end)

    -- Faster Dashes
    local DashBox = addGroup(CombatTab, "Left", "Faster Dashes", "move-horizontal")
    DashBox:AddToggle("Dash_Enabled",  { Text="Faster Dashes", Default=false })
    DashBox:AddInput("Dash_SideBoost", { Text="Side Boost (studs/s)",  Default="40",  Numeric=true, Finished=false, Placeholder="0-300" })
    DashBox:AddInput("Dash_FrontBoost",{ Text="Front Boost (studs/s)", Default="25",  Numeric=true, Finished=false, Placeholder="0-300" })
    DashBox:AddInput("Dash_BackBoost", { Text="Back Boost (studs/s)",  Default="25",  Numeric=true, Finished=false, Placeholder="0-300" })
    DashBox:AddInput("Dash_Duration",  { Text="Boost Duration (ms)",   Default="250", Numeric=true, Finished=false, Placeholder="50-2000" })
    DashBox:AddToggle("Dash_Tracker",  { Text="Dash Cooldown Tracker (drag)", Default=false, Callback=function(v) Shared.setTrackerVisible(v) end })

    local SIDE_CD=2; local FB_CD=5; local cooldowns={side=0,frontBack=0}; local dashing=nil
    local trackerGui=Instance.new("ScreenGui"); trackerGui.Name="ChillDashTracker"; trackerGui.ResetOnSpawn=false; trackerGui.Enabled=false; trackerGui.Parent=LocalPlayer:WaitForChild("PlayerGui")
    local trackerLabel=Instance.new("TextLabel"); trackerLabel.Size=UDim2.fromOffset(190,46); trackerLabel.Position=UDim2.fromOffset(10,110); trackerLabel.BackgroundColor3=Color3.new(0,0,0); trackerLabel.BackgroundTransparency=0.4; trackerLabel.TextColor3=Color3.new(1,1,1); trackerLabel.Font=Enum.Font.GothamBold; trackerLabel.TextSize=14; trackerLabel.RichText=true; trackerLabel.Parent=trackerGui
    Instance.new("UICorner",trackerLabel).CornerRadius=UDim.new(0,6); makeDraggable(trackerLabel)
    Shared.setTrackerVisible=function(v) trackerGui.Enabled=v end
    onCleanup(function() Shared.setTrackerVisible=function(_v) end; trackerGui:Destroy() end)
    local function cdText(label,readyAt)
        local r=readyAt-os.clock()
        if r<=0 then return label..': <font color="rgb(120,255,140)">READY</font>' end
        return label..': <font color="rgb(255,120,120)">'..("%.1fs"):format(r).."</font>"
    end
    local ttimer=0
    connect(RunService.Heartbeat,function(dt)
        if not trackerGui.Enabled then return end; ttimer+=dt; if ttimer<0.1 then return end; ttimer=0
        trackerLabel.Text=cdText("Side",cooldowns.side).."\n"..cdText("Front/Back",cooldowns.frontBack)
    end)
    connect(UserInputService.InputBegan,function(input)
        if UserInputService:GetFocusedTextBox() or not inputMatchesBind(input,"Keybind_GameDash") then return end
        local hum=getHumanoid(); local root=getRoot(); local cam=workspace.CurrentCamera
        if not hum or not root or not cam then return end
        local look=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
        if look.Magnitude<0.01 then look=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z) end
        look=look.Unit
        local kind="front"; local dir=look; local move=hum.MoveDirection
        if move.Magnitude>0.1 then dir=Vector3.new(move.X,0,move.Z).Unit; local fd=dir:Dot(look); if fd>0.5 then kind="front" elseif fd<-0.5 then kind="back" else kind="side" end end
        local now=os.clock()
        local ready=(kind=="side" and now>=cooldowns.side) or (kind~="side" and now>=cooldowns.frontBack)
        if not ready then return end
        if kind=="side" then cooldowns.side=now+SIDE_CD else cooldowns.frontBack=now+FB_CD end
        if not Toggles.Dash_Enabled.Value or isRagdolled(hum) then return end
        local boost=(tonumber(Options.Dash_FrontBoost.Value) or 25)
        if kind=="side" then boost=(tonumber(Options.Dash_SideBoost.Value) or 40)
        elseif kind=="back" then boost=(tonumber(Options.Dash_BackBoost.Value) or 25) end
        dashing={kind=kind,direction=dir,speed=boost,endsAt=now+(tonumber(Options.Dash_Duration.Value) or 250)/1000}
    end)
    connect(RunService.Heartbeat,function(dt)
        if not dashing then return end; local root=getRoot()
        if not root or os.clock()>=dashing.endsAt or isRagdolled(getHumanoid()) then dashing=nil; return end
        local dir=dashing.direction
        if dashing.kind=="front" then local cam=workspace.CurrentCamera; if cam then local l=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z); if l.Magnitude>0.01 then dir=l.Unit end end end
        root.CFrame=root.CFrame+dir*(dashing.speed*dt)
    end)

    -- ----------------------------------------------------------------
    -- Lock-On  (FIX: no AutoRotate manipulation → no ragdoll weirdness)
    -- Camera lerps toward target. Character faces target via CFrame only
    -- when we're actually locked on and not ragdolled.
    -- ----------------------------------------------------------------
    local LockBox  = addGroup(CombatTab, "Right", "Lock-On", "locate-fixed")
    local lockTarget = nil; local marker = nil
    LockBox:AddLabel({ Text="Smooth lock-on targeting the closest player.", DoesWrap=true })
    LockBox:AddSlider("LockOn_Range",    { Text="Lock Range",       Min=10, Max=300, Default=120, Rounding=0, Suffix=" studs" })
    LockBox:AddSlider("LockOn_Smoothing",{ Text="Camera Snap Speed",Min=10, Max=100, Default=80,  Rounding=0, Suffix="%" })
    LockBox:AddToggle("LockOn_Marker",   { Text="Show Target UI Bracket", Default=true }):AddColorPicker("LockOn_BracketColor",{ Default=Color3.fromRGB(255,255,255), Title="Bracket Color" })

    local function targetTorsoInfo(plr)
        local char=plr.Character; if not char then return nil,nil end
        local torso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
        local hum=char:FindFirstChildOfClass("Humanoid")
        if torso and hum and hum.Health>0 then return torso,hum end
        return nil,nil
    end
    local function removeMarker() if marker then marker.gui:Destroy(); marker=nil end end
    local function findClosestTarget()
        local myRoot=getRoot(); if not myRoot then return nil end
        local best=nil; local bestDist=Options.LockOn_Range.Value
        for _,plr in Players:GetPlayers() do
            if plr~=LocalPlayer then
                local torso=targetTorsoInfo(plr)
                if torso then
                    local d=(torso.Position-myRoot.Position).Magnitude
                    if d<=bestDist then bestDist=d; best=plr end
                end
            end
        end
        return best
    end
    -- FIX: no setAutoRotateLock — that was causing the ragdoll weirdness
    local function setLock(plr)
        lockTarget=plr; removeMarker()
        if plr then Library:Notify("Locked: "..playerLabel(plr),2) else Library:Notify("Lock Released",2) end
    end
    local function toggleLock()
        if lockTarget then setLock(nil); return end
        local target=findClosestTarget()
        if target then setLock(target) else Library:Notify("No player in range",2) end
    end
    connect(UserInputService.InputBegan,function(input)
        if UserInputService:GetFocusedTextBox() then return end
        if inputMatchesBind(input,"LockOn_Key") then toggleLock() end
    end)
    local function createTargetBracket(parent,color)
        local gui=Instance.new("BillboardGui"); gui.Name="ChillLockBracketUI"; gui.Size=UDim2.fromOffset(130,130); gui.AlwaysOnTop=true; gui.Adornee=parent; gui.Parent=parent
        local container=Instance.new("Frame",gui); container.Size=UDim2.fromScale(1,1); container.BackgroundTransparency=1
        local function makeCorner(xScale,xOff,yScale,yOff,w1,h1,w2,h2)
            local f1=Instance.new("Frame",container); f1.Size=UDim2.fromOffset(w1,h1); f1.Position=UDim2.new(xScale,xOff,yScale,yOff); f1.BackgroundColor3=color; f1.BorderSizePixel=0
            local f2=Instance.new("Frame",container); f2.Size=UDim2.fromOffset(w2,h2); f2.Position=UDim2.new(xScale,xOff,yScale,yOff); f2.BackgroundColor3=color; f2.BorderSizePixel=0
        end
        makeCorner(0,0,0,0,24,3,3,24); makeCorner(1,-24,0,0,24,3,3,24)
        makeCorner(0,0,1,-24,24,3,3,24); makeCorner(1,-24,1,-24,24,3,3,24)
        return gui
    end
    pcall(function() RunService:UnbindFromRenderStep("ChillLockOn") end)
    RunService:BindToRenderStep("ChillLockOn",Enum.RenderPriority.Camera.Value+1,function(dt)
        if not lockTarget then return end
        local cam=workspace.CurrentCamera; local myRoot=getRoot(); local myHum=getHumanoid()
        if not cam or not myRoot then return end
        local torso,_hum=targetTorsoInfo(lockTarget)
        -- release only if dead/gone or out of max range
        if not torso or (torso.Position-myRoot.Position).Magnitude>Options.LockOn_Range.Value then
            setLock(nil); Library:Notify("Lock-on released (Out of range)",2); return
        end
        -- camera lerp toward torso
        local snapPower=Options.LockOn_Smoothing.Value/100
        local lookPos=Vector3.new(torso.Position.X,torso.Position.Y+0.5,torso.Position.Z)
        local targetCF=CFrame.lookAt(cam.CFrame.Position,lookPos)
        cam.CFrame=cam.CFrame:Lerp(targetCF, math.clamp(dt*(snapPower*20),0.05,0.95))
        -- face target: ONLY rotate HRP on XZ plane, do NOT touch AutoRotate or PlatformStand
        if myHum and not isRagdolled(myHum) then
            local flat=Vector3.new(torso.Position.X,myRoot.Position.Y,torso.Position.Z)
            if (flat-myRoot.Position).Magnitude>0.5 then
                myRoot.CFrame=CFrame.new(myRoot.Position,flat)
            end
        end
        -- marker
        if Toggles.LockOn_Marker.Value then
            local col=Options.LockOn_BracketColor and Options.LockOn_BracketColor.Value or Color3.fromRGB(255,255,255)
            if not marker or marker.gui.Parent~=torso then
                removeMarker()
                marker={gui=createTargetBracket(torso,col)}
            end
        else removeMarker() end
    end)
    onCleanup(function() pcall(function() RunService:UnbindFromRenderStep("ChillLockOn") end); removeMarker() end)
end

