    -- Backdash 1–4
    -- Pattern: equip number → hold S → click (light attack) → Q dash → release S → equip number
    -- This is the standard backdash input in TSB.
    local NUMBER_KEYS={Enum.KeyCode.One,Enum.KeyCode.Two,Enum.KeyCode.Three,Enum.KeyCode.Four}
    for i=1,4 do
        local nk=NUMBER_KEYS[i]
        addMacro("Backdash"..i,"Backdash "..i,function()
            fireKey(nk)          -- equip
            waitMs(30)           -- settle
            keyDown(Enum.KeyCode.S)  -- hold back
            waitMs(8)
            clickMouse()         -- light attack / cancel
            waitMs(12)
            fireKey(Enum.KeyCode.Q)  -- dash
            waitMs(8)
            keyUp(Enum.KeyCode.S)    -- release back
            waitMs(20)
            fireKey(nk)          -- re-equip
        end)
    end
