    SafeBox:AddSlider("Combat_Safezone_Height",      { Text="Safezone Height",   Min=100, Max=3000, Default=500, Rounding=0, Suffix=" studs" })
    SafeBox:AddSlider("Combat_Safezone_Size",        { Text="Platform Size",     Min=60,  Max=800,  Default=400, Rounding=0, Suffix=" studs" })
