                    if d<=LD.LOCK_DISTANCE and d<bestD then bestD=d; best=torso end
                end
            end
        end
        return best
    end

    local function lethalSetup(char)
        lethalChar=char; lethalHum=char:WaitForChild("Humanoid"); lethalHRP=char:WaitForChild("HumanoidRootPart"); lethalBusy=false
        if lethalAnimConn then lethalAnimConn:Disconnect() end
        lethalAnimConn=lethalHum.AnimationPlayed:Connect(function(track)
            if not Toggles.LethalDash_Enabled.Value then return end
            if not (track.Animation and track.Animation.AnimationId==LD.DETECT_ANIM) then return end
            if lethalBusy then return end
            lethalBusy=true; lethalSmooth=true; lethalLastCF=lethalCam.CFrame
            task.delay(2,function() lethalSmooth=false end)

            task.wait(LD.WAIT_TIME + LD.PING_MS/1000)

            if not Toggles.LethalDash_Enabled.Value then lethalBusy=false; return end
            lethalHum:ChangeState(Enum.HumanoidStateType.Jumping); task.wait()
            local vel=lethalHRP.AssemblyLinearVelocity
            lethalHRP.AssemblyLinearVelocity=Vector3.new(vel.X, LD.VELO_POWER, vel.Z)
            lethalChar:WaitForChild("Communicate"):FireServer({Dash=Enum.KeyCode.W,Key=Enum.KeyCode.Q,Goal="KeyPress"})

            local target=lethalGetTorso()
            if target then
                task.delay(0.2+LD.PING_MS/1000,function()
                    if not target or not target.Parent then return end
                    local startT=tick(); local snapDur=LD.SNAP_DURATION; local conn
                    conn=RunService.RenderStepped:Connect(function()
                        if not Toggles.LethalDash_Enabled.Value or (tick()-startT)>=snapDur or not target or not target.Parent then
                            -- restore AutoRotate cleanly
                            if lethalHum and lethalHum.Parent then lethalHum.AutoRotate=true end
                            conn:Disconnect(); return
                        end
                        if lethalHum and lethalHum.Parent then lethalHum.AutoRotate=false end
                        local myPos=lethalHRP.Position; local tPos=target.Position
                        local flat=Vector3.new(tPos.X,myPos.Y,tPos.Z)
                        local tCF=CFrame.new(myPos,flat)
                        local prog=math.clamp((tick()-startT)/snapDur,LD.LERP_START,1)
                        local smooth=prog*prog*(3-2*prog)
                        lethalHRP.CFrame=lethalHRP.CFrame:Lerp(tCF,smooth)
                    end)
                end)
            end
            lethalBusy=false
        end)
    end

