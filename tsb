local function getHumanoid() local c=LocalPlayer.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot()     local c=LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart") end

-- waitMs: needed by macro helpers
local function waitMs(ms) task.wait(ms / 1000) end

local function isRagdolled(humanoid)
    if not humanoid then return false end
    -- Only treat as ragdolled if PlatformStand is true AND we aren't flying
    if humanoid.PlatformStand and not (Toggles.Universal_Flying_Enabled and Toggles.Universal_Flying_Enabled.Value) then return true end
    local s = humanoid:GetState()
    return s == Enum.HumanoidStateType.Ragdoll
        or s == Enum.HumanoidStateType.FallingDown
        or s == Enum.HumanoidStateType.Physics
end

local Shared = { flinging=false, restoreNoclip=function() end, setTrackerVisible=function(_v) end }

-- autoRotateLocks: only used by spin/attach — NOT by lock-on (that was the ragdoll bug)
local autoRotateLocks = {}
local function setAutoRotateLock(name, locked)
    autoRotateLocks[name] = locked or nil
    local h = getHumanoid()
    if h then h.AutoRotate = (next(autoRotateLocks) == nil) end
end
connect(LocalPlayer.CharacterAdded, function(char)
    local h = char:WaitForChild("Humanoid", 10)
    if h then h.AutoRotate = (next(autoRotateLocks) == nil) end
end)

local function resolvePlayer(v)
    if typeof(v) == "Instance" then return v end
    if type(v) == "string" then return Players:FindFirstChild(v) end
    return nil
end

local function playerLabel(plr)
    if not plr then return "?" end
    if plr.DisplayName ~= plr.Name then return plr.DisplayName.." ("..plr.Name..")" end
    return plr.Name
end

local function keyFromOption(name)
    local opt = Options[name]; if not opt then return nil end
    return Enum.KeyCode:FromName(tostring(opt.Value))
end

local function inputMatchesBind(input, name)
    local opt = Options[name]; if not opt then return false end
    local v = tostring(opt.Value)
    if v == "None" then return false end
    if v == "MB1" then return input.UserInputType == Enum.UserInputType.MouseButton1 end
    if v == "MB2" then return input.UserInputType == Enum.UserInputType.MouseButton2 end
    if v == "MB3" then return input.UserInputType == Enum.UserInputType.MouseButton3 end
    local kc = Enum.KeyCode:FromName(v)
    return kc ~= nil and input.KeyCode == kc
end

