        local names={"XRay_Enabled","Fullbright_Enabled","LowQuality_Enabled","Camera_UnlockZoom","Fun_Disco","Fun_Rainbow","Fun_Spin","Fun_Trail","Universal_Noclip","Universal_Flying_Enabled","Universal_Speed_Enabled","Universal_Jump_Enabled","Universal_Gravity_Enabled","Universal_InfJump","Spectate_Enabled","Attach_Enabled","AntiVoid_Enabled","QoL_NoEffects","QoL_AlwaysDay","QoL_NoFog","Dash_Enabled","Dash_Tracker","Combat_Safezone_Enabled","FlingAura_Enabled","LethalDash_Enabled","TouchFling_Enabled","Universal_AntiStun","Aurora_Custom_Enabled","Macro_Backdash1_Enabled","Macro_Backdash2_Enabled","Macro_Backdash3_Enabled","Macro_Backdash4_Enabled"}
        for _,name in names do local t=Toggles[name]; if t then pcall(function() t:SetValue(false) end) end end
        Library:Notify("All features turned off",3)
    end })
    MenuGroup:AddButton({ Text="Unload Script", Func=function() Library:Unload() end })
    pcall(function() MenuGroup:AddToggle("KeybindMenuOpen",{ Default=Library.KeybindFrame.Visible, Text="Show Keybind List", Callback=function(v) Library.KeybindFrame.Visible=v end }) end)
    pcall(function() MenuGroup:AddDropdown("NotificationSide",{ Values={"Left","Right"}, Default="Right", Text="Notification Side", Callback=function(v) Library:SetNotifySide(v) end }) end)
    pcall(function() MenuGroup:AddDropdown("DPIDropdown",{ Values={"50%","75%","100%","125%","150%","175%","200%"}, Default="100%", Text="DPI Scale", Callback=function(v) local dpi=tonumber((v:gsub("%%",""))); if dpi then Library:SetDPIScale(dpi) end end }) end)

    Library:OnUnload(function()
        unloaded=true
        for _,c in connections do pcall(function() c:Disconnect() end) end
        for _,fn in cleanupFns do pcall(fn) end
    end)

    if okTheme and ThemeManager then ThemeManager:SetLibrary(Library); ThemeManager:SetFolder("ChillhubTSB"); ThemeManager:ApplyToTab(SettingsTab)
    else warn("[Chillhub] ThemeManager failed:",ThemeManager) end
    if okSave and SaveManager then
        SaveManager:SetLibrary(Library); if okTheme then SaveManager:IgnoreThemeSettings() end
        SaveManager:SetIgnoreIndexes({"MenuKeybind","QoL_Theme"}); SaveManager:SetFolder("ChillhubTSB"); SaveManager:BuildConfigSection(SettingsTab); SaveManager:LoadAutoloadConfig()
    else warn("[Chillhub] SaveManager failed:",SaveManager) end
end

themeUiReady=true
end -- buildUI

local okBuild,buildErr=xpcall(buildUI,function(e) return tostring(e).."\n"..debug.traceback() end)
if not okBuild then
    warn("[Chillhub] UI build failed:",buildErr)
    pcall(function() Loading:ShowErrorPage(true); Loading:SetErrorMessage("Failed to build the UI, check the console (F9) for details.") end)
    return
end

pcall(function() Loading:SetCurrentStep(4); Loading:Continue() end)
Library:Notify("Chillhub v17 loaded 🎃",6)
