    local function removeInfo(plr) local b=infoBB[plr]; if b then b.gui:Destroy(); infoBB[plr]=nil end end
    local function updateHL(plr)
        local char=plr.Character
        if plr==LocalPlayer or not Toggles.ESP_Enabled.Value or not char then removeHL(plr); return end
        local hum=char:FindFirstChildOfClass("Humanoid"); if not hum then removeHL(plr); return end
        local h=espHL[plr]
        if not h or not h.Parent or h.Adornee~=char then
            if h then h:Destroy() end
            h=Instance.new("Highlight"); h.Name="ChillESP"; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Adornee=char; h.Parent=char; espHL[plr]=h
        end
        local fc=Options.ESP_Fill_Color.Value; local oc=Options.ESP_Outline_Color.Value
        if Toggles.ESP_HealthColor.Value and hum.MaxHealth>0 then
            local r=math.clamp(hum.Health/hum.MaxHealth,0,1); fc=Color3.fromHSV(r*0.33,1,1); oc=fc
        end
        h.FillColor=fc;    h.FillTransparency=Toggles.ESP_Fill_Enabled.Value and 0.75 or 1
        h.OutlineColor=oc; h.OutlineTransparency=Toggles.ESP_Outline_Enabled.Value and 0 or 1
    end
    local function updateInfo(plr)
        local char=plr.Character; local head=char and char:FindFirstChild("Head"); local hum=char and char:FindFirstChildOfClass("Humanoid")
        local wN=Toggles.ESP_Names.Value; local wH=Toggles.ESP_Health.Value; local wD=Toggles.ESP_Distance.Value
        if plr==LocalPlayer or not head or not hum or not(wN or wH or wD) then removeInfo(plr); return end
        local board=infoBB[plr]
        if not board or not board.gui.Parent then
            if board then board.gui:Destroy() end
            local gui=Instance.new("BillboardGui"); gui.Name="ChillInfoESP"; gui.Size=UDim2.fromOffset(200,60); gui.StudsOffset=Vector3.new(0,3,0); gui.AlwaysOnTop=true; gui.Adornee=head; gui.Parent=head
            local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.fromScale(1,1); lbl.BackgroundTransparency=1; lbl.TextColor3=Color3.new(1,1,1); lbl.TextStrokeTransparency=0; lbl.Font=Enum.Font.GothamBold; lbl.TextSize=13; lbl.Parent=gui
            board={gui=gui,label=lbl}; infoBB[plr]=board
        end
        local lines={}
        if wN then table.insert(lines, playerLabel(plr)) end
        if wH then table.insert(lines, ("HP: %d/%d"):format(math.floor(hum.Health),math.floor(hum.MaxHealth))) end
        if wD then local myRoot=getRoot(); if myRoot then table.insert(lines, ("%d studs"):format(math.floor((myRoot.Position-head.Position).Magnitude))) end end
        board.label.Text = table.concat(lines,"\n")
    end
    local function hookPlayer(plr)
        if plr==LocalPlayer then return end
        if plr.Character then task.spawn(function() task.wait(0.5); pcall(function() updateHL(plr) end) end) end
        connect(plr.CharacterAdded, function() task.wait(0.5); pcall(function() updateHL(plr) end) end)
    end
    for _,p in Players:GetPlayers() do hookPlayer(p) end
    connect(Players.PlayerAdded,   hookPlayer)
    connect(Players.PlayerRemoving,function(p) removeHL(p); removeInfo(p) end)
    task.spawn(function()
        while not unloaded do
            for _,p in Players:GetPlayers() do if p~=LocalPlayer then pcall(function() updateHL(p); updateInfo(p) end) end end
            task.wait(0.25)
        end
    end)
    onCleanup(function() for p in espHL do removeHL(p) end; for p in infoBB do removeInfo(p) end end)

    -- World & Camera
    local WorldBox = addGroup(VisualsTab, "Left", "World & Camera", "globe")
    local xrayOn=false; local xrayParts={}; local xrayGen=0
    local function belongsToChar(o) local m=o:FindFirstAncestorWhichIsA("Model"); while m do if m:FindFirstChildOfClass("Humanoid") then return true end; m=m:FindFirstAncestorWhichIsA("Model") end; return false end
    local function xrayVal() return ((Options.XRay_Transparency and Options.XRay_Transparency.Value) or 60)/100 end
    local function applyXray(o,v) if o:IsA("BasePart") and not o:IsA("Terrain") and not belongsToChar(o) then if xrayParts[o]==nil then xrayParts[o]=o.LocalTransparencyModifier end; o.LocalTransparencyModifier=v end end
    local function restoreXray() for part,orig in xrayParts do if part.Parent then part.LocalTransparencyModifier=orig end; xrayParts[part]=nil end end
    local function refreshXray()
        xrayGen+=1; local gen=xrayGen; if not xrayOn then restoreXray(); return end
        local v=xrayVal(); for part in xrayParts do if part.Parent then part.LocalTransparencyModifier=v else xrayParts[part]=nil end end
        local count=0; for _,o in workspace:GetDescendants() do if gen~=xrayGen then return end; applyXray(o,v); count+=1; if count%1500==0 then task.wait() end end
    end
    connect(workspace.DescendantAdded, function(o) if xrayOn then task.defer(function() if xrayOn then applyXray(o,xrayVal()) end end) end end)
    WorldBox:AddToggle("XRay_Enabled",      { Text="X-Ray", Default=false, Callback=function(v) xrayOn=v; task.spawn(refreshXray) end })
    WorldBox:AddSlider("XRay_Transparency", { Text="X-Ray Transparency", Min=10, Max=95, Default=60, Rounding=0, Suffix="%", Callback=function() if xrayOn then task.spawn(refreshXray) end end })
    local defMax=LocalPlayer.CameraMaxZoomDistance; local defMin=LocalPlayer.CameraMinZoomDistance
    WorldBox:AddToggle("Camera_UnlockZoom", { Text="Unlock Camera Zoom", Default=false, Callback=function(v)
        if v then LocalPlayer.CameraMaxZoomDistance=10000; LocalPlayer.CameraMinZoomDistance=0.5
        else LocalPlayer.CameraMaxZoomDistance=defMax; LocalPlayer.CameraMinZoomDistance=defMin end
    end })
    onCleanup(function() xrayOn=false; refreshXray() end)
end

