-- keyFromOption & inputMatchesBind: WindUI Keybind returns string names like "Q", "Space"
local function keyFromOption(name)
    local v = Flags[name]; if not v then return nil end
    if typeof(v)=="EnumItem" then return v end
    return Enum.KeyCode:FromName(tostring(v))
end

local function inputMatchesBind(input, name)
    local v = Flags[name]; if not v then return false end
    if typeof(v)=="EnumItem" then return input.KeyCode==v end
    local str = tostring(v)
    if str=="" or str=="None" then return false end
    if str=="MB1" then return input.UserInputType==Enum.UserInputType.MouseButton1 end
    if str=="MB2" then return input.UserInputType==Enum.UserInputType.MouseButton2 end
    if str=="MB3" then return input.UserInputType==Enum.UserInputType.MouseButton3 end
    local kc = Enum.KeyCode:FromName(str)
    return kc~=nil and input.KeyCode==kc
end

