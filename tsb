-- Remembered config name so the chosen config can auto-load next run.
local AUTOLOAD_PATH = "ChillhubTSB/autoload.txt"
local function readAutoLoadName()
    if type(readfile)~="function" or type(isfile)~="function" then return nil end
    local ok,data=pcall(function() if isfile(AUTOLOAD_PATH) then return readfile(AUTOLOAD_PATH) end end)
    if ok and type(data)=="string" then
        local name=data:match("^%s*(.-)%s*$")
        if name~="" then return name end
    end
    return nil
end
local function writeAutoLoadName(name)
    if type(writefile)~="function" then return false end
    return pcall(function()
        if type(isfolder)=="function" and not isfolder("ChillhubTSB") then makefolder("ChillhubTSB") end
        writefile(AUTOLOAD_PATH,tostring(name))
    end)
end
local function clearAutoLoadName()
    local ok=pcall(function()
        if type(delfile)=="function" and type(isfile)=="function" and isfile(AUTOLOAD_PATH) then delfile(AUTOLOAD_PATH) end
    end)
    return ok
end

