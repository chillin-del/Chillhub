end

local function addGroup(tab, side, name, icon)
    if tab.AddGroupbox then
        local ok, box = pcall(function() return tab:AddGroupbox({Side=side,Name=name,IconName=icon}) end)
        if ok and box then return box end
    end
    if side == "Left" then return tab:AddLeftGroupbox(name, icon) end
    return tab:AddRightGroupbox(name, icon)
end

local function makeDraggable(frame, moveTarget)
    moveTarget = moveTarget or frame; frame.Active = true
    local dragging, dragStart, startPos = false, nil, nil
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = moveTarget.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    local c = connect(UserInputService.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            moveTarget.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y)
        end
    end)
    return function() c:Disconnect() end
end

