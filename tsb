    UtilSection:Toggle({ Title="Anti AFK", Value=true, Flag="QoL_AntiAFK", Callback=function(v) Flags.QoL_AntiAFK=v end })
    connect(LocalPlayer.Idled,function() if Flags.QoL_AntiAFK then VirtualUser:CaptureController(); VirtualUser:ClickButton2(Vector2.new()) end end)
    UtilSection:Toggle({ Title="Join / Leave Notifications", Value=false, Flag="QoL_JoinLeave", Callback=function(v) Flags.QoL_JoinLeave=v end })
    connect(Players.PlayerAdded,   function(p) if Flags.QoL_JoinLeave then Notify(playerLabel(p).." joined",3) end end)
    connect(Players.PlayerRemoving,function(p) if Flags.QoL_JoinLeave then Notify(playerLabel(p).." left",  3) end end)
    UtilSection:Toggle({ Title="FPS Cap", Value=false, Flag="QoL_FpsUnlock", Callback=function(v)
        Flags.QoL_FpsUnlock=v
        if type(setfpscap)~="function" then if v then Notify("Your executor doesn't support setfpscap",4) end; return end
        setfpscap(v and (tonumber(Flags.QoL_FpsCap) or 144) or 60)
    end })
    UtilSection:Input({ Title="FPS Cap Value", Value="144", Placeholder="60-9999", Flag="QoL_FpsCap",
        Callback=function(v) Flags.QoL_FpsCap=v; if type(setfpscap)=="function" and Flags.QoL_FpsUnlock then setfpscap(tonumber(v) or 144) end end })
    UtilSection:Button({ Title="Reset Character", Callback=function() local h=getHumanoid(); if h then h.Health=0 end end })
    UtilSection:Button({ Title="Copy Job ID",     Callback=function() if copy(game.JobId) then Notify("Job ID copied",3) else Notify("Clipboard not supported",4) end end })
    UtilSection:Button({ Title="Server Hop", Callback=function()
        Notify("Searching for a server...",3)
        task.spawn(function()
            local ok,result=pcall(function() return HttpService:JSONDecode(game:HttpGet(("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId))) end)
            if not ok or not result or not result.data then Notify("Couldn't fetch server list",5); return end
            for _,server in result.data do if server.id~=game.JobId and server.playing<server.maxPlayers then TeleportService:TeleportToPlaceInstance(game.PlaceId,server.id,LocalPlayer); return end end
            Notify("No other servers found",4)
        end)
    end })

    local CleanSection = QoLTab:Section({ Title="Visual Cleanup" })
    local qolDisabledEff={}
    CleanSection:Toggle({ Title="Remove Screen Effects", Value=false, Flag="QoL_NoEffects", Callback=function(on)
        Flags.QoL_NoEffects=on
        for _,e in Lighting:GetChildren() do if e:IsA("PostEffect") then if on then if e.Enabled then qolDisabledEff[e]=true; e.Enabled=false end elseif qolDisabledEff[e] then e.Enabled=true; qolDisabledEff[e]=nil end end end
    end })
    local savedClock=nil
    CleanSection:Toggle({ Title="Always Day", Value=false, Flag="QoL_AlwaysDay", Callback=function(on) Flags.QoL_AlwaysDay=on; if on then savedClock=Lighting.ClockTime elseif savedClock then Lighting.ClockTime=savedClock; savedClock=nil end end })
    local savedFog=nil
    CleanSection:Toggle({ Title="Remove Fog",  Value=false, Flag="QoL_NoFog",    Callback=function(on) Flags.QoL_NoFog=on; if on then savedFog=Lighting.FogEnd; Lighting.FogEnd=100000 elseif savedFog then Lighting.FogEnd=savedFog; savedFog=nil end end })
    local qolT=0
    connect(RunService.Heartbeat,function(dt)
        qolT+=dt; if qolT<1 then return end; qolT=0
        if Flags.QoL_AlwaysDay and math.abs(Lighting.ClockTime-14)>0.05 then Lighting.ClockTime=14 end
        if Flags.QoL_NoFog     and Lighting.FogEnd<100000 then Lighting.FogEnd=100000 end
    end)
    CleanSection:Toggle({ Title="Hide Chat",        Value=false, Flag="QoL_HideChat",       Callback=function(on) Flags.QoL_HideChat=on;       pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat,      not on) end) end })
    CleanSection:Toggle({ Title="Hide Player List", Value=false, Flag="QoL_HidePlayerList", Callback=function(on) Flags.QoL_HidePlayerList=on; pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,not on) end) end })
    onCleanup(function() pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat,true); StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,true) end) end)

    local ServerSection = QoLTab:Section({ Title="Server Tools" })
    ServerSection:Input({ Title="Job ID", Value="", Placeholder="paste a Job ID", Flag="QoL_JobId", Callback=function(v) Flags.QoL_JobId=v end })
    ServerSection:Button({ Title="Join Job ID", Callback=function()
        local id=tostring(Flags.QoL_JobId or ""):gsub("%s+",""); if id=="" then Notify("Paste a Job ID first",3); return end
        local ok,err=pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId,id,LocalPlayer) end); if not ok then Notify("Couldn't join: "..tostring(err),5) end
    end })
    ServerSection:Button({ Title="Copy Place ID", Callback=function() if copy(tostring(game.PlaceId)) then Notify("Place ID copied",3) else Notify("Clipboard not supported",4) end end })
    ServerSection:Toggle({ Title="Auto Reconnect On Kick", Value=false, Flag="QoL_AutoReconnect", Callback=function(v) Flags.QoL_AutoReconnect=v end })
    task.spawn(function()
        local ok,overlay=pcall(function() local g=game:GetService("CoreGui"):WaitForChild("RobloxPromptGui",10); return g and g:WaitForChild("promptOverlay",10) end)
        if not ok or not overlay then return end
        connect(overlay.ChildAdded,function(child) if child.Name=="ErrorPrompt" and Flags.QoL_AutoReconnect then task.wait(2); pcall(function() TeleportService:Teleport(game.PlaceId,LocalPlayer) end) end end)
    end)

    local ThemeSection = QoLTab:Section({ Title="Theme" })
    ThemeSection:Dropdown({ Title="WindUI Theme", Values={"Dark","Light","Flamingo","Lavender","Pink","Red","Maroon","Peach","Yellow","Green","Teal","Blue","Sapphire","Sky","Mauve"}, Value="Dark",
        Flag="QoL_Theme", Callback=function(name) Flags.QoL_Theme=name; pcall(function() WindUI:SetTheme(name) end) end })

    local InfoSection = QoLTab:Section({ Title="Game Info" })
    local gameLabel=InfoSection:Paragraph({ Title="Game", Desc="loading..." }); InfoSection:Paragraph({ Title="Place ID", Desc=tostring(game.PlaceId) })
    task.spawn(function()
        local mp=game:GetService("MarketplaceService"); local ok,info=pcall(function() return mp:GetProductInfoAsync(game.PlaceId) end)
        pcall(function() gameLabel:SetDesc(ok and info and "Game: "..tostring(info.Name) or "unknown") end)
    end)
end

task.wait()
------------------------------------------------------------
-- SETTINGS TAB
------------------------------------------------------------
do
    local MenuSection = SettingsTab:Section({ Title="Menu" })
    MenuSection:Button({ Title="Turn Off All Features", Callback=function()
        local names={
            "XRay_Enabled","Fullbright_Enabled","LowQuality_Enabled","Camera_UnlockZoom",
            "Fun_Disco","Fun_Rainbow","Fun_Spin","Fun_Trail",
            "Universal_Noclip","Universal_Flying_Enabled","Universal_Speed_Enabled",
            "Universal_Jump_Enabled","Universal_Gravity_Enabled","Universal_InfJump",
            "Spectate_Enabled","Attach_Enabled","AutoRejoin_Enabled",
            "QoL_NoEffects","QoL_AlwaysDay","QoL_NoFog","QoL_FpsUnlock","QoL_AutoReconnect",
            "Dash_Enabled","Dash_Tracker","Combat_Safezone_Enabled",
            "FlingAura_Enabled","LethalDash_Enabled","TouchFling_Enabled","AntiHit_Enabled",
            "Invis_Enabled",
            "Macro_Backdash1_Enabled","Macro_Backdash2_Enabled","Macro_Backdash3_Enabled","Macro_Backdash4_Enabled",
            "ESP_Skeleton","Appearance_Korblox","Appearance_Headless","MoveLock_Enabled",
        }
        for _,name in names do Flags[name]=false end
        pcall(function() RunService:UnbindFromRenderStep("ChillSpectate") end)
        pcall(Shared.renderRestore)
        Notify("All features turned off",3)
    end })
    MenuSection:Button({ Title="Unload Script", Callback=function()
        unloaded=true
        for _,c in connections do pcall(function() c:Disconnect() end) end
        for _,fn in cleanupFns do pcall(fn) end
        pcall(function() Window:Destroy() end)
    end })
    MenuSection:Paragraph({ Title="Version", Desc="Chillhub v"..tostring(UPDATE_VERSION) })

    -- Config system using WindUI's built-in ConfigManager
    local CfgSection = SettingsTab:Section({ Title="Configs" })
    local function cfgReady() return ConfigManager and ConfigManager.CreateConfig end
    local function getConfig(name)
        if not cfgReady() then return nil end
        return ConfigManager:CreateConfig(name)
    end
    local function cfgList()
        if not (ConfigManager and ConfigManager.AllConfigs) then return {} end
        local ok,list=pcall(function() return ConfigManager:AllConfigs() end)
        if not ok or type(list)~="table" then return {} end
        return list
    end
    local function cfgListStr()
        local list=cfgList()
        if #list==0 then return "(none)" end
        return table.concat(list,",  ")
    end
    local cfgListPara = CfgSection:Paragraph({ Title="Saved Configs", Desc=cfgListStr() })
    local cfgAutoPara  = CfgSection:Paragraph({ Title="Auto-Load",    Desc=readAutoLoadName() or "(not set)" })
    local function refreshCfgList()
        pcall(function() cfgListPara:SetDesc(cfgListStr()) end)
        pcall(function() cfgAutoPara:SetDesc(readAutoLoadName() or "(not set)") end)
    end

    local cfgNameInput = ""
    local cfgAutoLoad = true
    CfgSection:Input({ Title="Config Name", Value="", Placeholder="e.g. main, pvp, fun",
        Callback=function(v) cfgNameInput=v end })
    CfgSection:Toggle({ Title="Auto-Load On Start", Value=true, Callback=function(v) cfgAutoLoad=v end })
    CfgSection:Paragraph({ Title="", Desc="Save with Auto-Load on (or press Set As Auto-Load) and the chosen config loads itself next run." })
    CfgSection:Button({ Title="💾 Save Config", Callback=function()
        local name=cfgNameInput:match("^%s*(.-)%s*$")
        if name=="" then Notify("Enter a config name first",4); return end
        local ok,err=pcall(function()
            local cfg=getConfig(name); if not cfg then error("config system unavailable") end
            if cfg.SetAutoLoad then cfg:SetAutoLoad(cfgAutoLoad) end
            cfg:Save()
        end)
        if ok then
            if cfgAutoLoad then
                if writeAutoLoadName(name) then Notify("✔ Saved + auto-load: "..name,3)
                else Notify("✔ Saved: "..name,3) end
            else
                if readAutoLoadName()==name then clearAutoLoadName() end
                Notify("✔ Saved: "..name,3)
            end
        else Notify("✘ Save failed: "..tostring(err),5) end
        refreshCfgList()
    end })
    CfgSection:Button({ Title="📂 Load Config", Callback=function()
        local name=cfgNameInput:match("^%s*(.-)%s*$")
        if name=="" then Notify("Enter a config name to load",4); return end
        local ok,res=pcall(function()
            local cfg=getConfig(name); if not cfg then return false end
            return cfg:Load()
        end)
        if ok and res and res~=false then Notify("✔ Loaded: "..name,3)
        else Notify("✘ Not found: "..tostring(res),5) end
        refreshCfgList()
    end })
    CfgSection:Button({ Title="🗑 Delete Config", Callback=function()
        local name=cfgNameInput:match("^%s*(.-)%s*$")
        if name=="" then Notify("Enter a config name to delete",4); return end
        local ok,res=pcall(function()
            local cfg=getConfig(name); if not cfg then return false end
            return cfg:Delete()
        end)
        if ok and res==true then Notify("✔ Deleted: "..name,3)
        else Notify("✘ Delete failed: "..tostring(res),5) end
        if readAutoLoadName()==name then clearAutoLoadName() end
        refreshCfgList()
    end })
    CfgSection:Button({ Title="⭐ Set As Auto-Load", Callback=function()
        local name=cfgNameInput:match("^%s*(.-)%s*$")
        if name=="" then Notify("Enter a config name first",4); return end
        local ok,err=pcall(function()
            local cfg=getConfig(name); if not cfg then error("config system unavailable") end
            if cfg.SetAutoLoad then cfg:SetAutoLoad(true) end
            cfg:Save()
        end)
        if ok then
            writeAutoLoadName(name)
            Notify("⭐ Auto-load set: "..name,3)
        else Notify("✘ Failed: "..tostring(err),5) end
        refreshCfgList()
    end })
    CfgSection:Button({ Title="Clear Auto-Load", Callback=function()
        local current=readAutoLoadName()
        if current then
            pcall(function()
                local cfg=getConfig(current)
                if cfg and cfg.SetAutoLoad then cfg:SetAutoLoad(false); cfg:Save() end
            end)
        end
        clearAutoLoadName()
        Notify("Auto-load cleared",3)
        refreshCfgList()
    end })
    CfgSection:Button({ Title="🔄 Refresh List", Callback=function() refreshCfgList(); Notify("Config list refreshed",2) end })

    -- Apply the remembered config once every element exists. WindUI's own
    -- __autoload flag is used as a fallback for configs saved elsewhere.
    task.spawn(function()
        task.wait(0.4)
        if not cfgReady() then refreshCfgList(); return end
        local name=readAutoLoadName()
        local loaded=nil
        if name then
            local ok,res=pcall(function() local cfg=getConfig(name); if cfg then return cfg:Load() end end)
            if ok and res and res~=false then loaded=name
            else clearAutoLoadName(); Notify("Auto-load config missing: "..tostring(name),5) end
        end
        if not loaded then
            for _,n in ipairs(cfgList()) do
                local ok,cfg=pcall(getConfig,n)
                if ok and cfg and cfg.AutoLoad then
                    pcall(function() cfg:Load() end)
                    loaded=n; break
                end
            end
        end
        if loaded then Notify("Auto-loaded config: "..loaded,4) end
        refreshCfgList()
    end)
end

end -- buildUI()

------------------------------------------------------------
-- LOADING ANIMATION  (self-advancing while buildUI runs)
------------------------------------------------------------
local _lsDone = false
task.spawn(function()
    local pct=0.03
    local msgs={
        {0.20,"Building UI..."},
        {0.40,"Loading visuals..."},
        {0.60,"Setting up features..."},
        {0.80,"Configuring macros..."},
        {0.91,"Almost done..."},
    }
    local mi=1
    while not _lsDone and pct<0.91 do
        pct=math.min(pct+0.012,0.91)
        if msgs[mi] and pct>=msgs[mi][1] then LS.set(pct,msgs[mi][2]); mi+=1 else LS.set(pct) end
        task.wait(0.05)
    end
end)

task.spawn(function()
    local ok,err=xpcall(buildUI, function(e) return tostring(e).."\n"..debug.traceback() end)
    _lsDone=true
    if not ok then
        warn("[Chillhub] UI build failed:",err)
        LS.close()
        pcall(function() WindUI:Notify({ Title="Chillhub ERROR", Content="UI build failed — check F9 for details.", Duration=10 }) end)
    else
        LS.close()
        WindUI:Notify({ Title="Chillhub", Content="Chillhub v"..tostring(UPDATE_VERSION).." loaded 🎃", Duration=6 })
    end
end)
