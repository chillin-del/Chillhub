    local function lethalGetTorso()
        local lf=workspace:FindFirstChild("Live"); if not lf then return nil end
        local best=nil; local bestD=LD.LOCK_DISTANCE
        for _,v in lf:GetChildren() do
            if v:IsA("Model") and v~=lethalChar then
                local torso=v:FindFirstChild("UpperTorso") or v:FindFirstChild("Torso") or v:FindFirstChild("HumanoidRootPart")
                local hum=v:FindFirstChildOfClass("Humanoid")
                if torso and hum and hum.Health>0 then
