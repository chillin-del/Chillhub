local function makeDraggable(frame, moveTarget)
    moveTarget = moveTarget or frame; frame.Active = true
    local dragging, dragStart, startPos = false, nil, nil
    frame.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=moveTarget.Position
            input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then dragging=false end end)
        end
    end)
    local c = connect(UserInputService.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
            local delta=input.Position-dragStart
            moveTarget.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
        end
    end)
    return function() c:Disconnect() end
end

-- Helper: player name dropdown with live refresh
local function makePlayerDropdown(parent, title, flag)
    local names = {"(none)"}
    for _,p in Players:GetPlayers() do if p~=LocalPlayer then table.insert(names,p.Name) end end
    local dd = parent:Dropdown({ Title=title, Values=names, Value="(none)", Flag=flag,
        Callback=function(v) Flags[flag]=(v=="(none)") and nil or v end })
    connect(Players.PlayerAdded, function(p)
        table.insert(names, p.Name); pcall(function() dd:Refresh(names) end)
    end)
    connect(Players.PlayerRemoving, function(p)
        for i,n in ipairs(names) do if n==p.Name then table.remove(names,i); break end end
        pcall(function() dd:Refresh(names) end)
    end)
    return dd
end

-- moveSetContains: WindUI multi-dropdown stores an array {"label1","label2"}
local function moveSetContains(flagName, label)
    local v = Flags[flagName]
    if type(v)~="table" then return false end
    for _,item in ipairs(v) do if item==label then return true end end
    return false
end


