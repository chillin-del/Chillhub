    local spinAngle = 0; local randomOffset = Vector3.new(0, 0, 3); local randomTimer = 0
    AttachBox:AddDropdown("Attach_Target", { SpecialType="Player", ExcludeLocalPlayer=true, Text="Attach Target" })
    AttachBox:AddDropdown("Attach_Position", { Values={"Front","Back","Left","Right","Front Left","Front Right","Back Left","Back Right","Top","Bottom","Piggyback","Orbit","Vertical Orbit","Helix","Random"}, Default=2, Text="Attach Position" })
    AttachBox:AddInput("Attach_Distance",  { Text="Distance (studs)", Default="3", Numeric=true, Finished=false, Placeholder="1-25" })
    AttachBox:AddInput("Attach_SpinSpeed", { Text="Orbit Speed (deg/s)", Default="90", Numeric=true, Finished=false, Placeholder="10-720" })
    AttachBox:AddToggle("Attach_FaceTarget", { Text="Face Target", Default=false })
    AttachBox:AddToggle("Attach_Enabled", { Text="Attach To Player", Default=false })

    local function getAttachCF(tRoot, dt)
        local pos = Options.Attach_Position.Value
        local dist = math.clamp(tonumber(Options.Attach_Distance.Value) or 3, 0.5, 100)
        local base = tRoot.CFrame; local center = tRoot.Position
        local diag = dist * 0.7071; local result = nil; local alwaysFace = false; local faceOk = true
        spinAngle += (tonumber(Options.Attach_SpinSpeed.Value) or 90) * dt
        local rad = math.rad(spinAngle)
        if pos == "Front" then result = base * CFrame.new(0, 0, -dist)
        elseif pos == "Back" then result = base * CFrame.new(0, 0, dist)
        elseif pos == "Left" then result = base * CFrame.new(-dist, 0, 0)
        elseif pos == "Right" then result = base * CFrame.new(dist, 0, 0)
        elseif pos == "Front Left" then result = base * CFrame.new(-diag, 0, -diag)
        elseif pos == "Front Right" then result = base * CFrame.new(diag, 0, -diag)
        elseif pos == "Back Left" then result = base * CFrame.new(-diag, 0, diag)
        elseif pos == "Back Right" then result = base * CFrame.new(diag, 0, diag)
        elseif pos == "Top" then result = base * CFrame.new(0, dist, 0); faceOk = false
        elseif pos == "Bottom" then result = base * CFrame.new(0, -dist, 0); faceOk = false
        elseif pos == "Piggyback" then result = base * CFrame.new(0, dist*0.6, dist*0.35)
        elseif pos == "Orbit" then result = CFrame.new(center + Vector3.new(math.sin(rad)*dist, 0, math.cos(rad)*dist)); alwaysFace = true
        elseif pos == "Vertical Orbit" then result = CFrame.new(center + base.RightVector*(math.sin(rad)*dist) + base.UpVector*(math.cos(rad)*dist)); alwaysFace = true
        elseif pos == "Helix" then result = CFrame.new(center + Vector3.new(math.sin(rad)*dist, math.sin(rad*2)*dist*0.5, math.cos(rad)*dist)); alwaysFace = true
        elseif pos == "Random" then
            randomTimer += dt
            if randomTimer >= 0.4 then
                randomTimer = 0
                local d = Vector3.new(math.random(-100,100), math.random(-30,100), math.random(-100,100))
                if d.Magnitude < 1 then d = Vector3.new(0,0,1) end
                randomOffset = d.Unit * dist
            end
            result = CFrame.new(center + randomOffset); alwaysFace = true
        else result = base * CFrame.new(0, 0, dist) end
        if alwaysFace or (faceOk and Toggles.Attach_FaceTarget and Toggles.Attach_FaceTarget.Value) then
            result = CFrame.lookAt(result.Position, center)
        end
        return result
    end
    connect(RunService.Heartbeat, function(dt)
        if not Toggles.Attach_Enabled or not Toggles.Attach_Enabled.Value then return end
        local h = getHumanoid()
        if not h or h.Health <= 0 then return end
