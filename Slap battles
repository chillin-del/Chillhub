local okGame, gameErr = xpcall(function()
do
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
    local GameNetwork = nil

    local function getGameNetwork()
        if GameNetwork then return GameNetwork end
        local ok, mod = pcall(function()
            return require(ReplicatedStorage:WaitForChild("BACKEND"):WaitForChild("Lib"):WaitForChild("Network"))
        end)
        if ok then GameNetwork = mod end
        return GameNetwork
    end

    local function getDirectRemote(name)
        local net = getGameNetwork()
        if net and type(debug) == "table" and type(debug.getupvalues) == "function" then
            local ok, upvalues = pcall(debug.getupvalues, net.fireServer)
            if ok and type(upvalues) == "table" then
                for _, upvalue in ipairs(upvalues) do
                    if type(upvalue) == "function" then
                        local ok2, inner = pcall(debug.getupvalues, upvalue)
                        if ok2 and type(inner) == "table" then
                            for _, candidate in ipairs(inner) do
                                if type(candidate) == "table" then
                                    local remote = candidate[name]
                                    if remote and typeof(remote) == "Instance" then
                                        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") or remote:IsA("UnreliableRemoteEvent") then
                                            return remote
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        local folder = ReplicatedStorage:FindFirstChild("_NETWORK")
        local direct = folder and folder:FindFirstChild(name)
        if direct and typeof(direct) == "Instance" then
            if direct:IsA("RemoteEvent") or direct:IsA("RemoteFunction") or direct:IsA("UnreliableRemoteEvent") then
                return direct
            end
        end
        return nil
    end

    local function gameNetworkInvoke(name, ...)
        local args = table.pack(...)
        local direct = getDirectRemote(name)
        if direct and direct:IsA("RemoteFunction") then
            local ok, res = pcall(function() return direct:InvokeServer(table.unpack(args, 1, args.n)) end)
            return ok, res
        end
        local net = getGameNetwork()
        if net then
            local ok, res = pcall(function() return net.invokeServer(name, table.unpack(args, 1, args.n)) end)
            if ok then return true, res end
            return false, res
        end
        return false, "Network remote missing"
    end

    local function gameNetworkFire(name, ...)
        local args = table.pack(...)
        local direct = getDirectRemote(name)
        if direct and (direct:IsA("RemoteEvent") or direct:IsA("UnreliableRemoteEvent")) then
            local ok, err = pcall(function() direct:FireServer(table.unpack(args, 1, args.n)) end)
            return ok, err
        end
        local net = getGameNetwork()
        if net then
            local ok, err = pcall(function() net.fireServer(name, table.unpack(args, 1, args.n)) end)
            if ok then return true end
            return false, err
        end
        return false, "Network remote missing"
    end

    ----------------------------------------------------------
    -- PLAYER ESP
    ----------------------------------------------------------
    local espEntries = {}
    local espBonePairsR15 = {
        {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"}, {"LowerTorso","HumanoidRootPart"},
        {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
    }
    local espBonePairsR6 = {
        {"Head","Torso"},
        {"Torso","Left Arm"}, {"Torso","Right Arm"},
        {"Torso","Left Leg"}, {"Torso","Right Leg"},
    }

    local function espToggleOn(name)
        local t = Toggles[name]
        return t ~= nil and t.Value == true
    end

    local function espOptionColor(name, fallback)
        local c = Options[name] and Options[name].Value
        return typeof(c) == "Color3" and c or fallback
    end

    local function espColor()
        return espOptionColor("GameESP_Color", Color3.fromRGB(0, 255, 170))
    end

    local function espSkeletonColor()
        return espOptionColor("GameESP_SkeletonColor", Color3.fromRGB(255, 255, 255))
    end

    local function espSkeletonThickness()
        local v = Options.GameESP_SkeletonThickness and tonumber(Options.GameESP_SkeletonThickness.Value) or 1
        return math.clamp(v, 1, 5)
    end

    local function espMaxDistance()
        local v = Options.GameESP_MaxDistance and tonumber(Options.GameESP_MaxDistance.Value) or 1500
        return math.clamp(v, 50, 5000)
    end

    local function espHealthColor(hum)
        local maxHealth = hum and hum.MaxHealth or 100
        local health = hum and hum.Health or maxHealth
        local frac = maxHealth > 0 and math.clamp(health / maxHealth, 0, 1) or 1
        return Color3.fromHSV(frac * 0.33, 1, 1)
    end

    local function createSkeletonLines()
        if Drawing == nil or type(Drawing.new) ~= "function" then return nil end
        local lines = {}
        for i = 1, #espBonePairsR15 do
            local ok, line = pcall(function() return Drawing.new("Line") end)
            if not ok or not line then
                for _, l in ipairs(lines) do pcall(function() l:Remove() end) end
                return nil
            end
            line.Visible = false
            line.Thickness = 1
            line.Transparency = 0.7
            line.Color = Color3.fromRGB(255, 255, 255)
            lines[i] = line
        end
        return lines
    end

    local function destroySkeletonLines(lines)
        if not lines then return end
        for _, line in ipairs(lines) do
            pcall(function() line.Visible = false end)
            pcall(function() line:Remove() end)
            pcall(function() line:Destroy() end)
        end
    end

    local function destroyEspEntry(entry)
        if not entry then return end
        pcall(function() if entry.hl then entry.hl:Destroy() end end)
        pcall(function() if entry.bb then entry.bb:Destroy() end end)
        destroySkeletonLines(entry.skeleton)
    end

    local function clearESP()
        for _, entry in pairs(espEntries) do destroyEspEntry(entry) end
        table.clear(espEntries)
    end

    local function createESP(char, head)
        local fillOn = espToggleOn("GameESP_Fill")
        local outlineOn = espToggleOn("GameESP_Outline")

        local hl = Instance.new("Highlight")
        hl.Name = "ChillhubGameESP"
        hl.Adornee = char
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = fillOn and 0.68 or 1
        hl.OutlineTransparency = outlineOn and 0.05 or 1
        hl.Enabled = fillOn or outlineOn
        hl.Parent = char

        local bb = Instance.new("BillboardGui")
        bb.Name = "ChillhubGameESP"
        bb.Adornee = head
        bb.AlwaysOnTop = true
        bb.Size = UDim2.fromOffset(235, 74)
        bb.StudsOffset = Vector3.new(0, 2.6, 0)
        bb.Parent = head

        local label = Instance.new("TextLabel")
        label.Name = "Info"
        label.BackgroundTransparency = 1
        label.Size = UDim2.fromScale(1, 1)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 13
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0.65
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.TextWrapped = true
        label.Text = ""
        label.Parent = bb

        return {char = char, head = head, hl = hl, bb = bb, label = label}
    end

    local function updateESP()
        local on = espToggleOn("GameESP_Enabled")
        if not on then
            if next(espEntries) ~= nil then clearESP() end
            return
        end
        local lroot = getRoot()
        if not lroot then clearESP(); return end
        local maxDist = espMaxDistance()
        local baseColor = espColor()
        local fillOn = espToggleOn("GameESP_Fill")
        local outlineOn = espToggleOn("GameESP_Outline")
        local useHealthColor = espToggleOn("GameESP_HealthColor")
        local skeletonOn = espToggleOn("GameESP_Skeleton")
        local showNames = espToggleOn("GameESP_Names")
        local showHealth = espToggleOn("GameESP_Health")
        local showDistance = espToggleOn("GameESP_Distance")
        local showGlove = espToggleOn("GameESP_Glove")
        local showSlaps = espToggleOn("GameESP_Slaps")
        local seen = {}

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                seen[player] = true
                local char = player.Character
                local head = char and char:FindFirstChild("Head")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local entry = espEntries[player]

                if not (char and head and root and hum and hum.Health > 0) then
                    if entry then destroyEspEntry(entry); espEntries[player] = nil end
                else
                    local dist = (root.Position - lroot.Position).Magnitude
                    if dist > maxDist then
                        if entry then destroyEspEntry(entry); espEntries[player] = nil end
                    else
                        if not entry or entry.char ~= char or entry.head ~= head then
                            if entry then destroyEspEntry(entry) end
                            entry = createESP(char, head)
                            espEntries[player] = entry
                        end
                        if entry then
                            local stats = player:FindFirstChild("leaderstats")
                            local gloveObj = stats and stats:FindFirstChild("Glove")
                            local slapsObj = stats and stats:FindFirstChild("Slaps")
                            local glove = gloveObj and tostring(gloveObj.Value) or tostring(player:GetAttribute("Glove") or "?")
                            local slaps = slapsObj and tonumber(slapsObj.Value) or 0
                            local hp = math.max(0, math.floor(hum.Health + 0.5))
                            local name = player.DisplayName ~= "" and player.DisplayName or player.Name
                            local color = useHealthColor and espHealthColor(hum) or baseColor

                            entry.hl.FillColor = color
                            entry.hl.OutlineColor = color
                            entry.hl.FillTransparency = fillOn and 0.68 or 1
                            entry.hl.OutlineTransparency = outlineOn and 0.05 or 1
                            entry.hl.Enabled = fillOn or outlineOn
                            entry.bb.MaxDistance = maxDist

                            local parts = {}
                            if showNames then table.insert(parts, name) end
                            local meta = {}
                            if showHealth then table.insert(meta, hp.." HP") end
                            if showDistance then table.insert(meta, math.floor(dist + 0.5).."m") end
                            if #meta > 0 then table.insert(parts, table.concat(meta, " | ")) end
                            local extras = {}
                            if showGlove then table.insert(extras, glove) end
                            if showSlaps then table.insert(extras, slaps.." slaps") end
                            if #extras > 0 then table.insert(parts, table.concat(extras, " | ")) end

                            entry.bb.Enabled = #parts > 0
                            entry.label.Text = table.concat(parts, "\n")
                            entry.label.TextColor3 = color
                            if not skeletonOn then
                                for _, line in ipairs(entry.skeleton or {}) do line.Visible = false end
                            end
                        end
                    end
                end
            end
        end

        for player, entry in pairs(espEntries) do
            if not seen[player] then destroyEspEntry(entry); espEntries[player] = nil end
        end
    end

    local function hideSkeleton(entry)
        if not entry or not entry.skeleton then return end
        for _, line in ipairs(entry.skeleton) do
            pcall(function() line.Visible = false end)
        end
    end

    local function updateSkeleton(entry)
        if not entry or not entry.char or not entry.char.Parent then return end
        if not espToggleOn("GameESP_Enabled") or not espToggleOn("GameESP_Skeleton") then
            hideSkeleton(entry)
            return
        end
        if not entry.skeleton then entry.skeleton = createSkeletonLines() end
        if not entry.skeleton then return end
        local camera = workspace.CurrentCamera
        if not camera then hideSkeleton(entry); return end

        local isR15 = entry.char:FindFirstChild("UpperTorso") ~= nil
        local pairsList = isR15 and espBonePairsR15 or espBonePairsR6
        local color = espSkeletonColor()
        local thickness = espSkeletonThickness()

        for i, pair in ipairs(pairsList) do
            local line = entry.skeleton[i]
            if line then
                local p1 = entry.char:FindFirstChild(pair[1])
                local p2 = entry.char:FindFirstChild(pair[2])
                if p1 and p2 and p1:IsA("BasePart") and p2:IsA("BasePart") then
                    local v1, on1 = camera:WorldToViewportPoint(p1.Position)
                    local v2, on2 = camera:WorldToViewportPoint(p2.Position)
                    if on1 and on2 and v1.Z > 0 and v2.Z > 0 then
                        line.From = Vector2.new(v1.X, v1.Y)
                        line.To = Vector2.new(v2.X, v2.Y)
                        line.Color = color
                        line.Thickness = thickness
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        end
        for i = #pairsList + 1, #entry.skeleton do
            entry.skeleton[i].Visible = false
        end
    end

    connect(RunService.RenderStepped, function()
        if not espToggleOn("GameESP_Enabled") or not espToggleOn("GameESP_Skeleton") then return end
        for _, entry in pairs(espEntries) do
            updateSkeleton(entry)
        end
    end)

