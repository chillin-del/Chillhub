    local function currentSpecTarget()
        if spectateOverride and spectateOverride.Parent == Players then return spectateOverride end
        return resolvePlayer(Options.Spectate_Target.Value)
    end
    local function stopSpectate()
        if not spectating then return end
        spectating = false
        pcall(function() RunService:UnbindFromRenderStep("ChillSpectate") end)
        local cam = workspace.CurrentCamera
        if cam then
            cam.CameraType = savedCamType or Enum.CameraType.Custom
            local h = getHumanoid(); if h then cam.CameraSubject = h end
        end
        savedCamType = nil
    end
    local function startSpectate()
        local cam = workspace.CurrentCamera
        if spectating or not cam then return end
        if not currentSpecTarget() then
            Library:Notify("Pick a player to spectate first", 3)
            if Toggles.Spectate_Enabled then Toggles.Spectate_Enabled:SetValue(false) end
            return
        end
        spectating = true; savedCamType = cam.CameraType; lastFocus = nil; spectateDistance = 12
        RunService:BindToRenderStep("ChillSpectate", Enum.RenderPriority.Camera.Value + 2, function()
            local c = workspace.CurrentCamera; if not c then return end
            local plr = currentSpecTarget(); local char = plr and plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local h = char and char:FindFirstChildOfClass("Humanoid")
            if Options.Spectate_Mode and Options.Spectate_Mode.Value == "Camera Subject" then
                if h then
                    if c.CameraType ~= Enum.CameraType.Custom then c.CameraType = Enum.CameraType.Custom end
                    if c.CameraSubject ~= h then c.CameraSubject = h end
                end
                return
            end
            if root then lastFocus = root.Position + Vector3.new(0, 2, 0) end
            if not lastFocus then return end
            c.CameraType = Enum.CameraType.Scriptable
            c.CFrame = CFrame.new(lastFocus) * CFrame.Angles(0, spectateYaw, 0) * CFrame.Angles(spectatePitch, 0, 0) * CFrame.new(0, 0, spectateDistance)
        end)
    end
