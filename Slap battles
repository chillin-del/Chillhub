    ----------------------------------------------------------
    -- GLOVE EQUIP
    ----------------------------------------------------------
    local gloveStatusLabel = nil
    local gloveLastStatus = ""

    local function currentGlove()
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        local gloveObj = stats and stats:FindFirstChild("Glove")
        return gloveObj and tostring(gloveObj.Value) or tostring(LocalPlayer:GetAttribute("Glove") or "?")
    end

    local function ownedGloves()
        local list, seen = {}, {}
        local folder = LocalPlayer:FindFirstChild("_unlockedGloves")
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("BoolValue") and child.Value and not seen[child.Name] then
                    seen[child.Name] = true
                    table.insert(list, child.Name)
                end
            end
        end
        local current = currentGlove()
        if current ~= "" and current ~= "?" and not seen[current] then
            table.insert(list, current)
        end
        table.sort(list, function(a, b) return string.lower(a) < string.lower(b) end)
        if #list == 0 then table.insert(list, "Default") end
        return list
    end

    local function setGloveStatus(text)
        if text ~= gloveLastStatus then
            gloveLastStatus = text
            pcall(function() gloveStatusLabel:SetText(text) end)
        end
    end

    local function selectedGlove()
        local option = Options.GameGlove_Select
        local value = option and option.Value
        if type(value) == "table" then
            for _, item in pairs(value) do value = item; break end
        end
        return value and tostring(value) or ""
    end

    local function equipGlove()
        local name = selectedGlove()
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then
            setGloveStatus("Current: "..currentGlove().." | select a glove")
            return
        end
        if currentGlove() == name then
            setGloveStatus("Current: "..name.." | already equipped")
            return
        end
        local ok, err = gameNetworkFire("SelectGlove", name)
        if not ok then
            setGloveStatus("Current: "..currentGlove().." | failed")
            Library:Notify("Equip failed: "..tostring(err), 5)
            return
        end
        local deadline = os.clock() + 3
        repeat
            task.wait(0.1)
        until currentGlove() == name or os.clock() >= deadline
        if currentGlove() == name then
            setGloveStatus("Current: "..name.." | equipped")
            Library:Notify("Equipped "..name, 4)
        else
            setGloveStatus("Current: "..currentGlove().." | server did not equip "..name)
            Library:Notify("Server did not equip "..name.." (are you in the lobby?)", 5)
        end
    end

    local initialGloves = ownedGloves()
    local lastGloveList = initialGloves
    local gloveDropdown

    local function refreshGloveDropdown(force)
        if not gloveDropdown then return end
        local list = ownedGloves()
        if not force and #list == #lastGloveList then
            local same = true
            for i = 1, #list do
                if list[i] ~= lastGloveList[i] then same = false; break end
            end
            if same then return end
        end
        lastGloveList = list
        local selected = selectedGlove()
        gloveDropdown:SetValues(list)
        if selected == "" or not table.find(list, selected) then
            gloveDropdown:SetValue(list[1])
        end
    end

    local GloveBox = addGroup(GameTab, "Right", "Glove Equip", "hand")
    local initialGlove = currentGlove()
    if not table.find(initialGloves, initialGlove) then initialGlove = initialGloves[1] end
    gloveDropdown = GloveBox:AddDropdown("GameGlove_Select", {
        Values = initialGloves,
        Default = initialGlove,
        Searchable = true,
        Text = "Owned Gloves",
    })
    GloveBox:AddButton({ Text="Refresh Gloves", Func=function() refreshGloveDropdown(true); Library:Notify("Glove list refreshed", 3) end })
    GloveBox:AddButton({ Text="Equip Glove", Func=function() task.spawn(equipGlove) end })
    gloveStatusLabel = GloveBox:AddLabel("Current: "..currentGlove())
    GloveBox:AddLabel({ Text="Only gloves unlocked on this account are listed. Search inside the dropdown to filter them. The server still decides which gloves can be equipped.", DoesWrap=true })

    task.spawn(function()
        while not unloaded do
            task.wait(2)
            pcall(refreshGloveDropdown, false)
        end
    end)

    task.spawn(function()
        while not unloaded do
            task.wait(1)
            local current = currentGlove()
            if gloveLastStatus == "" or not string.find(gloveLastStatus, "Current: "..current, 1, true) then
                setGloveStatus("Current: "..current)
            end
        end
    end)
end
