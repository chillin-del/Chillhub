        local hits, glove, remoteName, hasRemote = fireAuraOnce()
        if hasRemote then
            setAuraStatus(hits > 0 and ("manual | "..glove.." | "..remoteName.." | "..hits.." target(s)") or ("manual | "..glove.." | "..remoteName.." | no targets"))
        else
