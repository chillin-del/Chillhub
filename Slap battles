    local arenaStatusLabel = nil

    local function setArenaStatus(text)
        pcall(function() arenaStatusLabel:SetText("Arena: "..text) end)
    end

    local function gameInArena()
        local char = LocalPlayer.Character
        if not char then return false end
        local flag = char:FindFirstChild("isInArena")
        if flag and flag:IsA("BoolValue") then return flag.Value end
        local entered = char:FindFirstChild("entered")
        if entered then return not entered:IsA("BoolValue") or entered.Value end
        return false
    end

    local function enterArenaGame()
        local char = LocalPlayer.Character
        if not char then setArenaStatus("no character"); return end
        if gameInArena() then setArenaStatus("already in"); return end
        local lobby = workspace:FindFirstChild("Lobby")
        local tp = lobby and lobby:FindFirstChild("Teleport1")
        if not tp then setArenaStatus("Teleport1 missing"); return end

        local saved = { part = tp, pivot = tp:GetPivot() }
        if tp:IsA("BasePart") then
            saved.collide = tp.CanCollide
            pcall(function() tp.CanCollide = false end)
        end

        local started = os.clock()
        local entered = false
        setArenaStatus("joining...")
        while not unloaded and os.clock() - started < 6 do
            char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not root or not tp.Parent then break end
            if gameInArena() then entered = true; break end
            pcall(function() tp:PivotTo(root.CFrame) end)
            task.wait()
        end
        pcall(function()
            saved.part:PivotTo(saved.pivot)
            if saved.collide ~= nil then saved.part.CanCollide = saved.collide end
        end)
        setArenaStatus(entered and "in arena" or "not entered (try again)")
        if entered then
            Library:Notify("Joined the arena", 4)
        else
            Library:Notify("Could not enter the arena; try again", 4)
        end
    end

    local function goToLobby()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and root) then Library:Notify("No character", 4); return end
        if root.Anchored then Library:Notify("Turn off the farm hold first", 4); return end
        if hum then hum.Sit = false end
        char:PivotTo(CFrame.new(-1294.5, 327.7, -5.3))
        setArenaStatus("lobby")
        Library:Notify("Teleported to the lobby", 4)
    end

