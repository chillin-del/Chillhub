local function isRagdolled(humanoid)
    if not humanoid then return false end
    local flyToggle = Toggles.Universal_Flying_Enabled
    local flying = flyToggle and flyToggle.Value
    if humanoid.PlatformStand and not flying then return true end
    if flying then return false end
    local s = humanoid:GetState()
    return s == Enum.HumanoidStateType.Ragdoll
        or s == Enum.HumanoidStateType.FallingDown
        or s == Enum.HumanoidStateType.Physics
        or s == Enum.HumanoidStateType.PlatformStanding
end

------------------------------------------------------------
-- SHARED LOCAL STEALTH
-- Hides the character on this client only. Other players still
-- receive your character from the server, so this cannot make
-- you invisible to them. It only removes visual clutter locally.
------------------------------------------------------------
local Shared = {}
do
    local hideReasons = {}
    local hidePartOrig = setmetatable({}, { __mode = "k" })
    local hideDecalOrig = setmetatable({}, { __mode = "k" })
    local hideFxOrig = setmetatable({}, { __mode = "k" })
    local hideHumOrig = setmetatable({}, { __mode = "k" })

    local function hideApply()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if hideHumOrig[hum] == nil then
                hideHumOrig[hum] = {
                    DisplayDistanceType = hum.DisplayDistanceType,
                    HealthDisplayType = hum.HealthDisplayType,
                    NameDisplayDistance = hum.NameDisplayDistance,
                    HealthDisplayDistance = hum.HealthDisplayDistance,
                }
            end
            pcall(function()
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                hum.NameDisplayDistance = 0
                hum.HealthDisplayDistance = 0
            end)
        end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                if hidePartOrig[d] == nil then
                    hidePartOrig[d] = { Transparency = d.Transparency, CastShadow = d.CastShadow }
                end
                pcall(function()
                    d.Transparency = 1
                    d.CastShadow = false
                end)
            elseif d:IsA("Decal") or d:IsA("Texture") then
                if hideDecalOrig[d] == nil then hideDecalOrig[d] = d.Transparency end
                pcall(function() d.Transparency = 1 end)
            elseif d:IsA("Highlight") or d:IsA("BillboardGui") or d:IsA("ParticleEmitter")
                or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
                if hideFxOrig[d] == nil then hideFxOrig[d] = d.Enabled end
                pcall(function() d.Enabled = false end)
            end
        end
    end

    local function hideRestore()
        for d, v in pairs(hidePartOrig) do
            if d.Parent then
                pcall(function()
                    d.Transparency = v.Transparency
                    d.CastShadow = v.CastShadow
                end)
            end
        end
        for d, v in pairs(hideDecalOrig) do
            if d.Parent then pcall(function() d.Transparency = v end) end
        end
        for d, v in pairs(hideFxOrig) do
            if d.Parent then pcall(function() d.Enabled = v end) end
        end
        for hum, v in pairs(hideHumOrig) do
            if hum.Parent then
                pcall(function()
                    hum.DisplayDistanceType = v.DisplayDistanceType
                    hum.HealthDisplayType = v.HealthDisplayType
                    hum.NameDisplayDistance = v.NameDisplayDistance
                    hum.HealthDisplayDistance = v.HealthDisplayDistance
                end)
            end
        end
        table.clear(hidePartOrig)
        table.clear(hideDecalOrig)
        table.clear(hideFxOrig)
        table.clear(hideHumOrig)
    end

    function Shared.setHidden(reason, on)
        if on then hideReasons[reason] = true else hideReasons[reason] = nil end
        if next(hideReasons) ~= nil then hideApply() else hideRestore() end
    end
    function Shared.isHidden()
        return next(hideReasons) ~= nil
    end

    local hideClock = 0
    connect(RunService.Heartbeat, function(dt)
        if next(hideReasons) == nil then return end
        hideClock += dt
        if hideClock < 0.35 then return end
        hideClock = 0
        hideApply()
    end)
    onCleanup(function()
        table.clear(hideReasons)
        hideRestore()
    end)
end

------------------------------------------------------------
-- SAFE SPOT / ANTI-VOID
-- The old anti-void pushed you to Y=60 at your current X/Z
-- whenever you dropped below -30, which happens all the time
-- on the lower islands, so you bounced upward forever over
-- the void. This version remembers the last solid ground you
-- stood on and puts you back there. Farms can also hold you
-- at a spot high above the lobby so hits cannot knock you off.
------------------------------------------------------------
local SafeSpot = {}
do
    local holdReasons   = {}
    local holdCFrame    = nil
    local returnCFrame  = nil
    local lastSafeCFrame = nil
    local lastSafeClock = 0
    local anchoredRoot  = nil
    local voidCooldown  = 0

    local VOID_Y   = -1200
    local LIFT     = 600
    local SAFE_OFF = 6

    local function lobbySpawnCFrame()
        local lobby = workspace:FindFirstChild("Lobby")
        local sp = lobby and lobby:FindFirstChild("SpawnLocation", true)
        if sp and sp:IsA("BasePart") then
            return CFrame.new(sp.Position + Vector3.new(0, SAFE_OFF, 0))
        end
        return nil
    end

    local function fallbackCFrame()
        return lobbySpawnCFrame() or CFrame.new(0, 1000, 0)
    end

    local function farmSpotCFrame()
        local base = lastSafeCFrame or lobbySpawnCFrame()
        if not base then return CFrame.new(0, 1000, 0) end
        return CFrame.new(base.Position + Vector3.new(0, LIFT, 0))
    end

    local function zeroVelocity(root)
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local function releaseAnchor()
        if anchoredRoot then
            pcall(function() anchoredRoot.Anchored = false end)
            anchoredRoot = nil
        end
    end

    function SafeSpot.hold(reason, spot)
        if next(holdReasons) == nil then
            returnCFrame = lastSafeCFrame
            holdCFrame = spot or farmSpotCFrame()
        end
        holdReasons[reason] = true
    end

    function SafeSpot.release(reason)
        holdReasons[reason] = nil
        if next(holdReasons) ~= nil then return end
        holdCFrame = nil
        releaseAnchor()
        local target = returnCFrame
        returnCFrame = nil
        local root = getRoot()
        if target and root then
            zeroVelocity(root)
            pcall(function() root.CFrame = CFrame.new(target.Position + Vector3.new(0, SAFE_OFF, 0)) end)
        end
    end

    function SafeSpot.isHolding()
        return next(holdReasons) ~= nil
    end

    function SafeSpot.getLastSafe()
        return lastSafeCFrame
    end

    function SafeSpot.teleportToSafety()
        local root = getRoot()
        local hum = getHumanoid()
        if not root or not hum or hum.Health <= 0 then return end
        local target = lastSafeCFrame or fallbackCFrame()
        zeroVelocity(root)
        pcall(function() root.CFrame = CFrame.new(target.Position + Vector3.new(0, SAFE_OFF, 0)) end)
    end

    connect(RunService.Heartbeat, function(dt)
        local root = getRoot()
        local hum = getHumanoid()

        if not root or not hum or hum.Health <= 0 then
            releaseAnchor()
            return
        end

        if next(holdReasons) ~= nil then
            if not holdCFrame then holdCFrame = farmSpotCFrame() end
            if anchoredRoot ~= root then
                releaseAnchor()
                anchoredRoot = root
            end
            pcall(function() root.Anchored = true end)
            zeroVelocity(root)
            pcall(function() root.CFrame = holdCFrame end)
            return
        end

        releaseAnchor()

        local now = os.clock()
        if root.Position.Y > VOID_Y + 100 and hum.FloorMaterial ~= Enum.Material.Air then
            if now - lastSafeClock >= 0.25 then
                lastSafeClock = now
                lastSafeCFrame = root.CFrame
            end
        end

        voidCooldown = math.max(0, voidCooldown - dt)
        if root.Position.Y < VOID_Y and voidCooldown <= 0 then
            voidCooldown = 1.5
            SafeSpot.teleportToSafety()
        end
    end)

    onCleanup(function()
        table.clear(holdReasons)
        holdCFrame = nil
        returnCFrame = nil
        releaseAnchor()
    end)
end

local baseWalkSpeed  = setmetatable({}, { __mode = "k" })
local baseJump       = setmetatable({}, { __mode = "k" })
local baseAutoRotate = setmetatable({}, { __mode = "k" })

local function captureBaseline(h)
    if not h then return end
    if baseWalkSpeed[h] == nil then baseWalkSpeed[h] = h.WalkSpeed end
    if baseJump[h] == nil then
        baseJump[h] = {
            UseJumpPower = h.UseJumpPower,
            JumpPower = h.JumpPower,
            JumpHeight = h.JumpHeight,
        }
    end
    if baseAutoRotate[h] == nil then baseAutoRotate[h] = h.AutoRotate end
end

local autoRotateLocks = {}
local function applyAutoRotate(h)
    h = h or getHumanoid()
    if not h then return end
    captureBaseline(h)
    if next(autoRotateLocks) ~= nil then
        h.AutoRotate = false
    else
        h.AutoRotate = baseAutoRotate[h] ~= false
    end
end
local function setAutoRotateLock(name, locked)
    autoRotateLocks[name] = locked or nil
    applyAutoRotate()
end

connect(LocalPlayer.CharacterAdded, function(char)
    local h = char:WaitForChild("Humanoid", 10)
    if h then
        captureBaseline(h)
        applyAutoRotate(h)
    end
end)
captureBaseline(getHumanoid())
onCleanup(function()
    table.clear(autoRotateLocks)
    local h = getHumanoid()
    if h then h.AutoRotate = baseAutoRotate[h] ~= false end
end)

local function resolvePlayer(v)
    if typeof(v) == "Instance" then return v end
    if type(v) == "string" then return Players:FindFirstChild(v) end
    return nil
end

local function playerLabel(plr)
    if not plr then return "?" end
    if plr.DisplayName ~= plr.Name then return plr.DisplayName.." ("..plr.Name..")" end
    return plr.Name
end

local function keyFromOption(name)
    local opt = Options[name]
    if not opt then return nil end
    local v = opt.Value
    if type(v) ~= "string" then return nil end
    local ok, key = pcall(function() return Enum.KeyCode:FromName(v) end)
    if ok then return key end
    return nil
end

local function addGroup(tab, side, name, icon)
    if tab.AddGroupbox then
        local ok, box = pcall(function() return tab:AddGroupbox({Side=side,Name=name,IconName=icon}) end)
        if ok and box then return box end
    end
    if side == "Left" then return tab:AddLeftGroupbox(name, icon) end
    return tab:AddRightGroupbox(name, icon)
end

local function copy(text)
    local ok = pcall(function() setclipboard(tostring(text)) end)
    return ok
end

local function makeDraggable(frame, moveTarget)
    moveTarget = moveTarget or frame; frame.Active = true
    local dragging, dragStart, startPos = false, nil, nil
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = moveTarget.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    local c = connect(UserInputService.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            moveTarget.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y)
        end
    end)
    return function() c:Disconnect() end
end

