    local lastGloves = {}

    local function updateGloveNotifier()
        local on = Toggles.GameGloveNotify and Toggles.GameGloveNotify.Value
        if not on then
            if next(lastGloves) ~= nil then table.clear(lastGloves) end
            return
        end
        local seen = {}
        for _, player in ipairs(Players:GetPlayers()) do
            seen[player] = true
            local stats = player:FindFirstChild("leaderstats")
            local gloveObj = stats and stats:FindFirstChild("Glove")
            if gloveObj then
                local current = tostring(gloveObj.Value)
                local old = lastGloves[player]
                if old == nil then
                    lastGloves[player] = current
                elseif old ~= current then
                    lastGloves[player] = current
                    local name = player.DisplayName ~= "" and player.DisplayName or player.Name
                    pcall(function() Library:Notify(name.." equipped "..current, 4) end)
                end
            end
        end
        for player in pairs(lastGloves) do
            if not seen[player] then lastGloves[player] = nil end
        end
    end

    task.spawn(function()
        while not unloaded do
            updateGloveNotifier()
            task.wait(0.5)
