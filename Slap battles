    local function cycleSpec(step)
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(list, p) end end
        if #list == 0 then Library:Notify("No other players", 3); return end
        table.sort(list, function(a, b) return a.Name < b.Name end)
        local cur = currentSpecTarget(); local idx = 0
        for i, p in ipairs(list) do if p == cur then idx = i end end
        spectateOverride = list[((idx - 1 + step) % #list) + 1]
        Library:Notify("Spectating "..playerLabel(spectateOverride), 2)
    end
