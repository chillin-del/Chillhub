local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local okLib, Library = pcall(function() return loadstring(game:HttpGet(repo.."Library.lua"))() end)
if not okLib or not Library then
    error("[FF Autoplay] failed to load UI library: "..tostring(Library))
end
local okTheme, ThemeManager = pcall(function() return loadstring(game:HttpGet(repo.."addons/ThemeManager.lua"))() end)

local Options = Library.Options
local Toggles = Library.Toggles

local Window = Library:CreateWindow({
    Title         = "Funky Friday",
    Footer        = "Chillhub Autoplay",
    ToggleKeybind = Enum.KeyCode.P,
    Center        = true,
    AutoShow      = true,
    Icon          = LOGO_ASSET_ID,
})

local _menuLast = 0
Library.ToggleCallback = function()
    local now = os.clock()
    if now - _menuLast < 0.3 then return false end
    _menuLast = now
    return true
end

pcall(function()
    if okTheme and ThemeManager then
        ThemeManager:SetLibrary(Library)
        ThemeManager:ApplyTheme("Tokyo Night")
    end
end)

local conn
local refreshStatus = function() end

local AutoplayTab = Window:AddTab("Autoplay", "music")
local SettingsTab = Window:AddTab("Settings", "settings")

local ControlsBox = AutoplayTab:AddLeftGroupbox("Autoplay")

ControlsBox:AddToggle("FF_Autoplay", {
    Text = "Enable Autoplay",
    Default = true,
    Callback = function(v)
        state.enabled = v
        if not v then
            for i = 1, 4 do releaseLane(i) end
            state.side = nil
            clearNotes()
        end
        refreshStatus()
    end,
}):AddKeyPicker("FF_Autoplay_Key", {
    Default = "F2",
    Mode = "Toggle",
    SyncToggleState = true,
    Text = "Autoplay Key",
})

ControlsBox:AddSlider("FF_TapHold", {
    Text = "Tap Hold",
    Default = 20,
    Min = 5,
    Max = 120,
    Rounding = 0,
    Suffix = " ms",
    Callback = function(v) state.tapHold = v / 1000 end,
})

ControlsBox:AddSlider("FF_HitWindow", {
    Text = "Hit Window",
    Default = 1,
    Min = 0.2,
    Max = 3,
    Rounding = 1,
    Suffix = "x",
    Callback = function(v) state.winMult = v end,
})

ControlsBox:AddButton({
    Text = "Reset Stats",
    Func = function()
        state.stats.presses = 0
        state.stats.holds = 0
        state.stats.errSum = 0
        state.stats.errN = 0
        state.stats.lastErr = 0
        refreshStatus()
    end,
})

local StatusBox = AutoplayTab:AddRightGroupbox("Status")
local stateLabel = StatusBox:AddLabel("Autoplay: ON")
local sideLabel  = StatusBox:AddLabel("Side: --")
local pressLabel = StatusBox:AddLabel("Presses: 0")
local holdLabel  = StatusBox:AddLabel("Holds: 0")
local errLabel   = StatusBox:AddLabel("Avg error: -- ms")
local noteLabel  = StatusBox:AddLabel("Notes tracked: 0")

local InfoBox = AutoplayTab:AddRightGroupbox("Info")
InfoBox:AddLabel("Auto-detects your side")
InfoBox:AddLabel("Long notes are held automatically")
InfoBox:AddLabel("Autoplay key: F2")
InfoBox:AddLabel("Menu key: P")

local SettingsBox = SettingsTab:AddLeftGroupbox("Script")
SettingsBox:AddButton({
    Text = "Unload Script",
    Func = function()
        for i = 1, 4 do releaseLane(i) end
        pcall(function() conn:Disconnect() end)
        genv().FF_Autoplay = nil
        pcall(function() Library:Unload() end)
    end,
})

local CreditsBox = SettingsTab:AddRightGroupbox("About")
CreditsBox:AddLabel("Funky Friday autoplay")
CreditsBox:AddLabel("Obsidian UI")
CreditsBox:AddLabel("Client-side only")

local function countNotes()
    local n = 0
    for _ in pairs(state.notes) do n = n + 1 end
    return n
end

function refreshStatus()
    if not stateLabel then return end
    stateLabel:SetText("Autoplay: "..(state.enabled and "ON" or "OFF"))
    sideLabel:SetText("Side: "..(state.side or "--"))
    pressLabel:SetText("Presses: "..state.stats.presses)
    holdLabel:SetText("Holds: "..state.stats.holds)
    local avg = state.stats.errN > 0 and (state.stats.errSum / state.stats.errN) or nil
    errLabel:SetText("Avg error: "..(avg and string.format("%.1f ms", avg) or "-- ms"))
    noteLabel:SetText("Notes tracked: "..countNotes())
end

local uiAccum = 0

conn = RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        local win = getWindow()
        if not win then
            for i = 1, 4 do releaseLane(i) end
            state.side = nil
            state.window = nil
            clearNotes()
            return
        end
        if state.window ~= win then
            for i = 1, 4 do releaseLane(i) end
            state.window = win
            state.side = nil
            clearNotes()
        end
        local g = win:FindFirstChild("Game")
        if not g then return end
        if not state.enabled then return end

        local s = sideFromScores(g)
        if s then
            state.side = s
        elseif not state.side then
            if os.clock() - state.lastDetect > 0.4 then
                state.lastDetect = os.clock()
                state.side = pressDetect(g)
            end
        end

        if state.side then
            releaseFinishedHolds()
            autoplay(g, dt)
        end
    end)
    uiAccum = uiAccum + dt
    if uiAccum >= 0.15 then
        uiAccum = 0
        refreshStatus()
    end
end)

genv().FF_Autoplay = {connection = conn, library = Library, state = state}
refreshStatus()
print("[FF Autoplay] loaded - F2 toggles autoplay, P opens the menu")
