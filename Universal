            lbl.TextColor3 = Color3.new(1,1,1); lbl.TextStrokeTransparency = 0
            lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 12; lbl.Parent = gui
            board = { gui = gui, label = lbl }; infoBoards[plr] = board
        end
        local lines = {}
        -- shows both display name and username
        if wN then table.insert(lines, playerLabel(plr)) end
        if wH then table.insert(lines, ("HP: %d / %d"):format(math.floor(hum.Health), math.floor(hum.MaxHealth))) end
        if wD then
            local myR = getRoot()
            if myR then table.insert(lines, ("%d studs"):format(math.floor((myR.Position - head.Position).Magnitude))) end
        end
        board.label.Text = table.concat(lines, "\n")
    end
 
    -- skeleton ESP
    local SKELETON_JOINTS_R15 = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    }
    local SKELETON_JOINTS_R6 = {
        {"Head","Torso"},
        {"Torso","Left Arm"},{"Left Arm","Left Hand"},
        {"Torso","Right Arm"},{"Right Arm","Right Hand"},
        {"Torso","Left Leg"},{"Left Leg","Left Foot"},
        {"Torso","Right Leg"},{"Right Leg","Right Foot"},
        {"HumanoidRootPart","Torso"},
    }
    local skeletonLines = {}
    local drawingOk = type(Drawing) == "table"
 
    local function getSkeletonJoints(character)
        return character:FindFirstChild("UpperTorso") and SKELETON_JOINTS_R15 or SKELETON_JOINTS_R6
    end
    local function getBoneColor()
        return Options.ESP_Skeleton_Color and Options.ESP_Skeleton_Color.Value or Color3.fromRGB(230, 230, 210)
    end
 
    -- fully removes and hides all skeleton lines for a player
    local function removeSkeleton(plr)
        local lines = skeletonLines[plr]; if not lines then return end
        for _, line in lines do
            pcall(function()
                line.Visible = false
                line:Remove()
            end)
        end
        skeletonLines[plr] = nil
    end
 
    -- safely clear all skeletons (avoids modifying table while iterating)
    local function clearAllSkeletons()
        local toRemove = {}
        for plr in skeletonLines do table.insert(toRemove, plr) end
        for _, plr in ipairs(toRemove) do removeSkeleton(plr) end
    end
 
    -- wire up skeleton toggle: when turned off, immediately remove all lines
    Toggles.ESP_Skeleton:OnChanged(function(v)
        if not v then clearAllSkeletons() end
    end)
 
    local function updateSkeleton(plr, camera)
        if not drawingOk then return end
        local character = plr.Character
        if plr==LocalPlayer or not Toggles.ESP_Skeleton.Value or not character or not Toggles.ESP_Enabled.Value then
            removeSkeleton(plr); return
        end
        local joints = getSkeletonJoints(character)
        local lines = skeletonLines[plr]
        if not lines or #lines ~= #joints then
            -- rebuild lines cleanly
            if lines then for _, l in lines do pcall(function() l.Visible=false; l:Remove() end) end end
            lines = {}
            for i = 1, #joints do
                local ok, line = pcall(function()
                    local l = Drawing.new("Line"); l.Thickness = 2; l.Transparency = 1
                    l.Color = getBoneColor(); l.Visible = false; return l
                end)
                if ok then lines[i] = line end
            end
            skeletonLines[plr] = lines
        end
        for i, pair in joints do
            local line = lines[i]; if not line then continue end
            local partA = character:FindFirstChild(pair[1]); local partB = character:FindFirstChild(pair[2])
            if partA and partB then
                local posA, onA = camera:WorldToViewportPoint(partA.Position)
                local posB, onB = camera:WorldToViewportPoint(partB.Position)
                if onA or onB then
                    line.From = Vector2.new(posA.X, posA.Y); line.To = Vector2.new(posB.X, posB.Y)
                    line.Color = getBoneColor(); line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
    end
 
    -- hook CharacterAdded so ESP applies on spawn/rejoin
    local function hookESPPlayer(plr)
        if plr == LocalPlayer then return end
        connect(plr.CharacterAdded, function()
            task.wait(0.5); pcall(function() updateHL(plr); updateInfo(plr) end)
        end)
        if plr.Character then pcall(function() updateHL(plr); updateInfo(plr) end) end
    end
    for _, plr in Players:GetPlayers() do hookESPPlayer(plr) end
    connect(Players.PlayerAdded, hookESPPlayer)
 
    connect(Players.PlayerRemoving, function(p)
        removeHL(p); removeInfo(p); removeSkeleton(p)
        local l = tracerLines[p]; if l then pcall(function() l:Remove() end); tracerLines[p] = nil end
    end)
 
    task.spawn(function()
        while not unloaded do
            for _, plr in Players:GetPlayers() do
                if plr ~= LocalPlayer then pcall(function() updateHL(plr); updateInfo(plr) end) end
            end
            task.wait(0.25)
        end
    end)
 
    connect(RunService.RenderStepped, function()
        if not drawingOk then return end
        local camera = workspace.CurrentCamera; if not camera then return end
 
        -- skeleton: if toggle off, clear all; if on, update per player
        if Toggles.ESP_Skeleton.Value then
            for _, plr in Players:GetPlayers() do
                if plr ~= LocalPlayer then pcall(function() updateSkeleton(plr, camera) end) end
            end
        else
            -- hide any lines that might still be visible
            for plr, lines in skeletonLines do
                for _, line in lines do pcall(function() line.Visible = false end) end
            end
        end
 
        -- tracers
        if not Toggles.ESP_Tracers_Enabled.Value then
            for _, l in tracerLines do pcall(function() l.Visible = false end) end
            return
        end
        local origin = nil; local myR = getRoot()
        if myR then local p, onScreen = camera:WorldToViewportPoint(myR.Position); if onScreen then origin = Vector2.new(p.X, p.Y) end end
        if not origin then local vp = camera.ViewportSize; origin = Vector2.new(vp.X/2, vp.Y/2) end
        local color = Options.ESP_Tracers_Color.Value
        for _, plr in Players:GetPlayers() do
            if plr ~= LocalPlayer then
                local c = plr.Character
                local tp = c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Head"))
                local line = tracerLines[plr]; local visible = false
                if tp then
                    local pos, onScreen = camera:WorldToViewportPoint(tp.Position)
                    if onScreen then
                        if not line then
                            local ok2, nl = pcall(function() local l = Drawing.new("Line"); l.Thickness = 1; l.Transparency = 1; return l end)
                            if ok2 then line = nl; tracerLines[plr] = line end
                        end
                        if line then line.From = origin; line.To = Vector2.new(pos.X, pos.Y); line.Color = color; line.Visible = true; visible = true end
                    end
                end
                if line and not visible then line.Visible = false end
            end
        end
    end)
 
    onCleanup(function()
        for p in espHighlights do removeHL(p) end
        for p in infoBoards do removeInfo(p) end
        clearAllSkeletons()
        for _, l in tracerLines do pcall(function() l:Remove() end) end
    end)
end
 
