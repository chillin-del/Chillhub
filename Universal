do
    local PerfBox    = addGroup(VisualsTab, "Left", "Performance & Lighting", "gauge")
    local ExtremeBox = addGroup(VisualsTab, "Left", "Extreme Low Quality",    "zap")
 
    local GREY_SKY = "rbxasset://textures/grey.png"
    local origGlobalShadows = Lighting.GlobalShadows
    local origSky   = Lighting:FindFirstChildOfClass("Sky")
    local skyClone  = origSky and origSky:Clone()
    local greySky   = nil; local lowQOn = false
    local disabledFx = {}; local disabledEffects = {}
 
    local function isFx(obj) return (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")) and obj.Name ~= "ChillTrail" end
    local function applyGreySky()
        if not greySky then
            greySky = Instance.new("Sky"); greySky.Name = "LQGreySky"
            for _, face in {"Bk","Dn","Ft","Lf","Rt","Up"} do greySky["Skybox"..face] = GREY_SKY end
        end
        local cur = Lighting:FindFirstChildOfClass("Sky"); if cur and cur ~= greySky then cur:Destroy() end
        greySky.Parent = Lighting
    end
    local function setLowQuality(on)
        lowQOn = on
        if on then Lighting.GlobalShadows = false; applyGreySky()
        else
            Lighting.GlobalShadows = origGlobalShadows
            if greySky then greySky.Parent = nil end
            if skyClone and not Lighting:FindFirstChildOfClass("Sky") then skyClone:Clone().Parent = Lighting end
        end
        for _, effect in Lighting:GetChildren() do
            if effect:IsA("PostEffect") then
                if on then if effect.Enabled then disabledEffects[effect] = true; effect.Enabled = false end
                elseif disabledEffects[effect] then effect.Enabled = true; disabledEffects[effect] = nil end
            end
        end
        for _, obj in workspace:GetDescendants() do
            if isFx(obj) then
                if on then if obj.Enabled then disabledFx[obj] = true; obj.Enabled = false end
                elseif disabledFx[obj] then obj.Enabled = true; disabledFx[obj] = nil end
            end
        end
    end
    connect(workspace.DescendantAdded, function(obj)
        if lowQOn and isFx(obj) then task.defer(function() if isFx(obj) then obj.Enabled = false end end) end
    end)
    PerfBox:AddToggle("LowQuality_Enabled", { Text = "Low Quality Mode", Default = false, Callback = setLowQuality })
 
    local savedLighting = nil
    PerfBox:AddToggle("Fullbright_Enabled", {
        Text = "Fullbright", Default = false,
        Callback = function(on)
            if on then
                savedLighting = { Brightness=Lighting.Brightness, ClockTime=Lighting.ClockTime, Ambient=Lighting.Ambient, OutdoorAmbient=Lighting.OutdoorAmbient, FogEnd=Lighting.FogEnd, GlobalShadows=Lighting.GlobalShadows }
                Lighting.Brightness=2; Lighting.ClockTime=14; Lighting.Ambient=Color3.new(1,1,1); Lighting.OutdoorAmbient=Color3.new(1,1,1); Lighting.FogEnd=100000; Lighting.GlobalShadows=false
            elseif savedLighting then for prop, v in savedLighting do Lighting[prop] = v end; savedLighting = nil end
        end
    })
    PerfBox:AddToggle("AlwaysDay_Enabled", { Text = "Always Day",  Default = false })
    PerfBox:AddToggle("NoFog_Enabled",     { Text = "Remove Fog",  Default = false })
    connect(RunService.Heartbeat, function()
        if Toggles.AlwaysDay_Enabled.Value then Lighting.ClockTime = 14 end
        if Toggles.NoFog_Enabled.Value and Lighting.FogEnd < 100000 then Lighting.FogEnd = 100000 end
    end)
 
    -- FOV: save original so we can restore it on toggle off
    local savedFOV = workspace.CurrentCamera and workspace.CurrentCamera.FieldOfView or 70
    PerfBox:AddToggle("FOV_Enabled", {
        Text = "Custom FOV", Default = false,
        Callback = function(v)
            if not v then
                local cam = workspace.CurrentCamera
                if cam then cam.FieldOfView = savedFOV end
            end
        end
    })
    PerfBox:AddSlider("FOV_Value", { Text = "FOV", Min = 60, Max = 120, Default = 80, Rounding = 0, Suffix = "°" })
    connect(RunService.RenderStepped, function()
        if not Toggles.FOV_Enabled.Value then return end
        local cam = workspace.CurrentCamera; local fov = Options.FOV_Value.Value
        if cam and cam.FieldOfView ~= fov then cam.FieldOfView = fov end
    end)
 
    local boostApplied = false
    local function applyMassiveBoost()
        if boostApplied then Library:Notify("FPS Boost already applied", 4); return end
        boostApplied = true
        pcall(function() Lighting.GlobalShadows = false; Lighting.Technology = Enum.Technology.Compatibility end)
        for _, child in Lighting:GetChildren() do
            if child:IsA("PostEffect") or child:IsA("Atmosphere") then pcall(function() child:Destroy() end) end
        end
        pcall(function()
            local terrain = workspace:FindFirstChildOfClass("Terrain"); if not terrain then return end
            terrain.Decoration=false; terrain.WaterWaveSize=0; terrain.WaterWaveSpeed=0; terrain.WaterReflectance=0; terrain.WaterTransparency=0
            local clouds = terrain:FindFirstChildOfClass("Clouds"); if clouds then clouds:Destroy() end
        end)
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        if type(setfflag) == "function" then pcall(function() setfflag("FIntDebugTextureManagerSkipMips","8") end) end
        local count = 0
        for _, obj in workspace:GetDescendants() do
            pcall(function()
                if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Trail") or obj:IsA("Beam") then obj.Enabled = false
                elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then obj.Enabled = false
                elseif obj:IsA("BasePart") and not obj:IsA("Terrain") then obj.Material = Enum.Material.SmoothPlastic; obj.Reflectance = 0; obj.CastShadow = false end
            end)
            count += 1; if count % 1500 == 0 then task.wait() end
        end
        Library:Notify("Massive FPS Boost applied. Rejoin to undo.", 6)
    end
 
    local extremeButton = ExtremeBox:AddButton({ Text = "Extreme Low Quality", Func = function()
        Library:Notify("Applying in 3s — rejoin to undo", 5)
        task.delay(3, function()
            if unloaded then return end; applyGreySky()
            pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)
            Lighting.GlobalShadows = false
            local count = 0
            for _, obj in workspace:GetDescendants() do
                pcall(function()
                    if obj:IsA("BasePart") then obj.Material = Enum.Material.SmoothPlastic; obj.Color = Color3.fromRGB(140,140,140); obj.Reflectance = 0
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency = 1
                    elseif obj:IsA("SpecialMesh") then obj.TextureId = ""
                    elseif obj:IsA("SurfaceAppearance") then obj.Parent = nil
                    elseif isFx(obj) then obj.Enabled = false end
                end)
                count += 1; if count % 1500 == 0 then task.wait() end
            end
            Library:Notify("Extreme Low Quality applied.", 5)
        end)
    end })
    extremeButton:AddButton({ Text = "Massive FPS Boost", Func = function()
        Library:Notify("Applying Massive FPS Boost...", 4); task.spawn(applyMassiveBoost)
    end })
end
 
