    local function drawLine(a2,b2,col,thick)
        local delta=b2-a2; local len=delta.Magnitude; if len<1 then return end
        local line=getLine(); line.Size=UDim2.fromOffset(len,thick); line.Position=UDim2.fromOffset(a2.X,a2.Y); line.Rotation=math.deg(math.atan2(delta.Y,delta.X)); line.BackgroundColor3=col; line.BackgroundTransparency=0
