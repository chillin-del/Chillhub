local unloaded    = false
local connections = {}
local cleanupFns  = {}

local function connect(signal, fn) local c=signal:Connect(fn); table.insert(connections,c); return c end
local function onCleanup(fn) table.insert(cleanupFns, fn) end
local function getHumanoid() local c=LocalPlayer.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot()     local c=LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart") end

local function isRagdolled(humanoid)
    if not humanoid then return false end
    if humanoid.PlatformStand and not (Toggles.Universal_Flying_Enabled and Toggles.Universal_Flying_Enabled.Value) then return true end
    local s = humanoid:GetState()
    return s==Enum.HumanoidStateType.Ragdoll or s==Enum.HumanoidStateType.FallingDown or s==Enum.HumanoidStateType.Physics
end

local Shared = { flinging=false, restoreNoclip=function() end, renderRestore=function() end }

local autoRotateLocks = {}
local function setAutoRotateLock(name, locked)
    autoRotateLocks[name] = locked or nil
    local h = getHumanoid()
    if h then h.AutoRotate = (next(autoRotateLocks)==nil) end
end
connect(LocalPlayer.CharacterAdded, function(char)
    local h = char:WaitForChild("Humanoid",10)
    if h then h.AutoRotate = (next(autoRotateLocks)==nil) end
end)

local function resolvePlayer(v)
    if typeof(v)=="Instance" then return v end
    if type(v)=="string" then return Players:FindFirstChild(v) end
    return nil
end
local function playerLabel(plr)
    if not plr then return "?" end
    if plr.DisplayName~=plr.Name then return plr.DisplayName.." ("..plr.Name..")" end
    return plr.Name
end
local function keyFromOption(name)
    local opt=Options[name]; if not opt then return nil end
    return Enum.KeyCode:FromName(tostring(opt.Value))
end
local function inputMatchesBind(input,name)
    local opt=Options[name]; if not opt then return false end
    local v=tostring(opt.Value)
    if v=="None" then return false end
    if v=="MB1" then return input.UserInputType==Enum.UserInputType.MouseButton1 end
    if v=="MB2" then return input.UserInputType==Enum.UserInputType.MouseButton2 end
    if v=="MB3" then return input.UserInputType==Enum.UserInputType.MouseButton3 end
    local kc=Enum.KeyCode:FromName(v); return kc~=nil and input.KeyCode==kc
end
local function copy(text)
    if type(setclipboard)=="function" then setclipboard(text); return true end; return false
end
local function addGroup(tab,side,name,icon)
    if tab.AddGroupbox then
        local ok,box=pcall(function() return tab:AddGroupbox({Side=side,Name=name,IconName=icon}) end)
        if ok and box then return box end
    end
    if side=="Left" then return tab:AddLeftGroupbox(name,icon) end
    return tab:AddRightGroupbox(name,icon)
end
local function makeDraggable(frame,moveTarget)
    moveTarget=moveTarget or frame; frame.Active=true
    local dragging,dragStart,startPos=false,nil,nil
    frame.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=moveTarget.Position
            input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then dragging=false end end)
        end
    end)
    local c=connect(UserInputService.InputChanged,function(input)
        if not dragging then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
            local delta=input.Position-dragStart
            moveTarget.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
        end
    end)
    return function() c:Disconnect() end
end

