    })
    AttachBox:AddSlider("Attach_Distance",  { Text = "Distance",    Min = 1,  Max = 25,  Default = 3,  Rounding = 1, Suffix = " studs" })
    AttachBox:AddSlider("Attach_SpinSpeed", { Text = "Orbit Speed", Min = 10, Max = 720, Default = 90, Rounding = 0, Suffix = "°/s" })
    AttachBox:AddToggle("Attach_FaceTarget",{ Text = "Face Target", Default = false })
    AttachBox:AddToggle("Attach_Enabled",   { Text = "Attach to Player", Default = false })
 
    local function getAttachCFrame(targetRoot, dt)
        local position = Options.Attach_Position.Value; local distance = Options.Attach_Distance.Value
        local base = targetRoot.CFrame; local center = targetRoot.Position; local diag = distance * 0.7071
        spinAngle += Options.Attach_SpinSpeed.Value * dt; local radians = math.rad(spinAngle)
        local result, faceAllowed = nil, true
        if     position == "Front"          then result = base * CFrame.new(0,0,-distance)
        elseif position == "Back"           then result = base * CFrame.new(0,0,distance)
        elseif position == "Left"           then result = base * CFrame.new(-distance,0,0)
        elseif position == "Right"          then result = base * CFrame.new(distance,0,0)
        elseif position == "Front Left"     then result = base * CFrame.new(-diag,0,-diag)
        elseif position == "Front Right"    then result = base * CFrame.new(diag,0,-diag)
        elseif position == "Back Left"      then result = base * CFrame.new(-diag,0,diag)
        elseif position == "Back Right"     then result = base * CFrame.new(diag,0,diag)
        elseif position == "Top"            then result = base * CFrame.new(0,distance,0);  faceAllowed = false
        elseif position == "Bottom"         then result = base * CFrame.new(0,-distance,0); faceAllowed = false
        elseif position == "Piggyback"      then result = base * CFrame.new(0,distance*0.6,distance*0.35)
        elseif position == "Orbit"          then result = CFrame.new(center + Vector3.new(math.sin(radians)*distance,0,math.cos(radians)*distance)); result = CFrame.lookAt(result.Position, center)
        elseif position == "Vertical Orbit" then result = CFrame.new(center + base.RightVector*(math.sin(radians)*distance) + base.UpVector*(math.cos(radians)*distance)); result = CFrame.lookAt(result.Position, center)
        elseif position == "Helix"          then result = CFrame.new(center + Vector3.new(math.sin(radians)*distance, math.sin(radians*2)*distance*0.5, math.cos(radians)*distance)); result = CFrame.lookAt(result.Position, center)
        elseif position == "Random"         then
            randomTimer += dt; if randomTimer >= 0.4 then randomTimer = 0; local d = Vector3.new(math.random(-100,100),math.random(-30,100),math.random(-100,100)); if d.Magnitude < 1 then d = Vector3.new(0,0,1) end; randomOffset = d.Unit * distance end
            result = CFrame.new(center + randomOffset); result = CFrame.lookAt(result.Position, center)
        else result = base * CFrame.new(0,0,distance) end
        if faceAllowed and Toggles.Attach_FaceTarget.Value then result = CFrame.lookAt(result.Position, center) end
        return result
    end
    connect(RunService.Heartbeat, function(dt)
        if not Toggles.Attach_Enabled.Value or Shared.flinging then return end
        local target = resolvePlayer(Options.Attach_Target.Value); local myR = getRoot()
        local tR = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if myR and tR then myR.CFrame = getAttachCFrame(tR, dt) end
    end)
 
