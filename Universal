    -- World Rendering toggles
    local WorldRenderBox=addGroup(VisualsTab,"Left","World Rendering","globe")
    WorldRenderBox:AddLabel({Text="Disable map categories to reduce clutter and improve FPS.",DoesWrap=true})
    local renderSaved,renderTerrainSaved,renderSkySaved={},nil,{}
    local renderGreySky,renderBusy,renderDirty,renderSuppress=nil,false,false,false
    local renderToggleRefs={}
    local V3Render={Trees=true,Rocks=true,Props=true,Clutter=true,Effects=true,Lights=true,Decals=true,Terrain=true,Sky=true}
    local renderNames={
        Trees={"tree","pine","palm","leaf","leaves","bush","shrub","foliage","forest","cactus","plant","flower","grass","vine","hedge"},
        Rocks={"mountain","rock","cliff","boulder","stone","cave","hill"},
        Props={"building","house","fence","prop","crate","barrel","chair","table","bench","lamp","sign","door","window","bridge","tower","statue","wall","roof"},
        Clutter={"clutter","debris","detail","decoration","junk","trash","rubble","gravestone"},
    }
    local function renderIsEffect(o) return (o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke") or o:IsA("Fire") or o:IsA("Sparkles")) and o.Name~="ChillTrail" end
    local function renderIsDecal(o) return o:IsA("Decal") or o:IsA("Texture") end
    local function renderIsFloor(o) if not o:IsA("BasePart") then return false end; local n=string.lower(o.Name); if n:find("baseplate",1,true) or n:find("floor",1,true) or n:find("ground",1,true) or n=="base" then return true end; local z=o.Size; return z.Y<=20 and math.max(z.X,z.Z)>=250 and math.min(z.X,z.Z)>=150 end
    local function renderProtected(o) local p,d=o,0; while p and p~=workspace and d<5 do if renderIsFloor(p) then return true end; p=p.Parent; d+=1 end; if inCharacter(o) and (o:IsA("BasePart") or renderIsDecal(o)) then return true end; return o.Name:sub(1,5)=="Chill" end
    local function renderText(o) local t,p,d=o.Name,o.Parent,0; while p and p~=workspace and d<3 do t=t.." "..p.Name; p=p.Parent; d+=1 end; return string.lower(t) end
    local function renderMatches(id,o,txt)
        if id=="Effects" then return renderIsEffect(o) end; if id=="Lights" then return o:IsA("Light") end; if id=="Decals" then return renderIsDecal(o) end; if id=="Terrain" then return o:IsA("Terrain") end; if id=="Sky" then return o:IsA("Sky") or o:IsA("Atmosphere") end
        if not(o:IsA("BasePart") or o:IsA("Model") or o:IsA("MeshPart") or o:IsA("UnionOperation")) then return false end
        for _,word in ipairs(renderNames[id] or {}) do if txt:find(word,1,true) then return true end end; return false
    end
    local function renderRemember(o,k,v) local saved=renderSaved[o]; if not saved then saved={}; renderSaved[o]=saved end; if saved[k]==nil then saved[k]=v end end
    local function renderHide(o)
        if renderProtected(o) then return end
        if o:IsA("BasePart") then renderRemember(o,"ltm",o.LocalTransparencyModifier); o.LocalTransparencyModifier=1
        elseif renderIsDecal(o) then renderRemember(o,"transparency",o.Transparency); o.Transparency=1
        elseif renderIsEffect(o) or o:IsA("Light") then renderRemember(o,"enabled",o.Enabled); o.Enabled=false end
    end
    local function renderRestoreObjects() for o,v in pairs(renderSaved) do if o.Parent then pcall(function() if v.ltm~=nil then o.LocalTransparencyModifier=v.ltm end; if v.transparency~=nil then o.Transparency=v.transparency end; if v.enabled~=nil then o.Enabled=v.enabled end end) end end; table.clear(renderSaved) end
    local function renderTerrain(hide) local t=workspace:FindFirstChildOfClass("Terrain"); if not t then return end; if hide then if not renderTerrainSaved then renderTerrainSaved={Decoration=t.Decoration,WaterWaveSize=t.WaterWaveSize,WaterWaveSpeed=t.WaterWaveSpeed,WaterReflectance=t.WaterReflectance,WaterTransparency=t.WaterTransparency} end; pcall(function() t.Decoration=false; t.WaterWaveSize=0; t.WaterWaveSpeed=0; t.WaterReflectance=0; t.WaterTransparency=0 end) elseif renderTerrainSaved then pcall(function() for k,v in pairs(renderTerrainSaved) do t[k]=v end end); renderTerrainSaved=nil end end
    local function renderSky(hide)
        if hide then
            if not renderGreySky then
                for _,obj in ipairs(Lighting:GetChildren()) do if obj:IsA("Sky") then table.insert(renderSkySaved,{obj=obj,parent=obj.Parent}); obj.Parent=nil end end
                renderGreySky=Instance.new("Sky"); renderGreySky.Name="ChillWorldGreySky"
                for _,face in ipairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do pcall(function() renderGreySky["Skybox"..face]="rbxasset://textures/grey.png" end) end
                renderGreySky.Parent=Lighting
            end
            for _,obj in ipairs(Lighting:GetChildren()) do if obj:IsA("Atmosphere") then if obj:GetAttribute("ChillRenderDensity")==nil then obj:SetAttribute("ChillRenderDensity",obj.Density) end; obj.Density=0 end end
        else
            for _,entry in ipairs(renderSkySaved) do if entry.obj and entry.parent then pcall(function() entry.obj.Parent=entry.parent end) end end; table.clear(renderSkySaved)
            if renderGreySky then renderGreySky:Destroy(); renderGreySky=nil end
            for _,obj in ipairs(Lighting:GetChildren()) do if obj:IsA("Atmosphere") then local d=obj:GetAttribute("ChillRenderDensity"); if d~=nil then obj.Density=d; obj:SetAttribute("ChillRenderDensity",nil) end end end
        end
    end
    local function renderShouldHide(o) if renderProtected(o) then return false end; local txt=renderText(o); for id,on in pairs(V3Render) do if not on and renderMatches(id,o,txt) then return true end end; return false end
    local function applyWorldRender()
        if renderBusy then renderDirty=true; return end; renderBusy=true
        repeat
            renderDirty=false; renderRestoreObjects(); renderTerrain(not V3Render.Terrain); renderSky(not V3Render.Sky)
            local active=false; for _,on in pairs(V3Render) do if not on then active=true; break end end
