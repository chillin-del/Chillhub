    local function updateHL(plr)
        local c = plr.Character
        if plr==LocalPlayer or not Toggles.ESP_Enabled.Value or not c then removeHL(plr); return end
        local hum = c:FindFirstChildOfClass("Humanoid"); if not hum then removeHL(plr); return end
