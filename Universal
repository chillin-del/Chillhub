        flyVelocity = Instance.new("LinearVelocity"); flyVelocity.Attachment0 = flyAttachment
        flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World; flyVelocity.MaxForce = math.huge
        flyVelocity.VectorVelocity = Vector3.zero; flyVelocity.Parent = flyAttachment
        flyConnection = RunService.Heartbeat:Connect(function()
