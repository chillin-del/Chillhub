                    if renderDirty then break end
                    if obj and obj.Parent and renderShouldHide(obj) then pcall(renderHide,obj) end
                    if idx%1000==0 then task.wait() end
                end
            end
        until not renderDirty
        renderBusy=false
    end
    local function setRenderCategory(id,on) V3Render[id]=on; if not renderSuppress then task.spawn(applyWorldRender) end end
    local renderTitles={{"Trees","Trees & Foliage"},{"Rocks","Rocks & Mountains"},{"Props","Buildings & Props"},{"Clutter","World Clutter"},{"Effects","Auras & Effects"},{"Lights","Lights"},{"Decals","Textures & Decals"},{"Terrain","Terrain Details"},{"Sky","Sky & Atmosphere"}}
    for _,entry in ipairs(renderTitles) do
