do
    local SoundService = game:GetService("SoundService")
    local PlayerBox    = addGroup(MusicTab, "Left",  "Player",   "music")
    local ControlBox   = addGroup(MusicTab, "Right", "Controls", "sliders-horizontal")
    local PlaylistBox  = addGroup(MusicTab, "Right", "Playlist", "list-music")
 
    local playlist={}
    for _,track in MUSIC_TRACKS do table.insert(playlist,{name=track.name,ids=track.ids}) end
    local function trackNames() local n={}; for _,t in playlist do table.insert(n,t.name) end; return n end
 
    local sound=Instance.new("Sound"); sound.Name="ChillMusic"; sound.Volume=0.5; sound.Parent=SoundService
    local currentIndex=0; local playToken=0
    local nowPlaying=PlayerBox:AddLabel({Text="Now Playing: nothing",DoesWrap=true})
    local function setStatus(text) nowPlaying:SetText(text) end
 
    PlayerBox:AddDropdown("Music_Track",{Values=trackNames(),Default=1,Text="Track"})
    local function selectedIndex() local v=Options.Music_Track.Value; for i,t in playlist do if t.name==v then return i end end; return 1 end
    local function refreshDropdown() pcall(function() Options.Music_Track:SetValues(trackNames()) end) end
 
    local function playTrack(index)
        local track=playlist[index]; if not track then return end
        currentIndex=index; playToken+=1; local token=playToken; setStatus("Loading: "..track.name.."...")
        task.spawn(function()
            for _,id in (track.ids or {}) do
                if token~=playToken then return end
                sound:Stop(); sound.SoundId="rbxassetid://"..id; sound.TimePosition=0; sound:Play()
                local waited=0
                while token==playToken and not sound.IsLoaded and waited<5 do task.wait(0.1); waited+=0.1 end
                if token~=playToken then return end
                if sound.IsLoaded and sound.TimeLength>0 then setStatus("Now Playing: "..track.name); return end
            end
            if token==playToken then sound:Stop(); setStatus("Couldn't load: "..track.name); Library:Notify(track.name.." — audio IDs may be private or removed.",7) end
        end)
    end
    local function nextIndex(step)
        if #playlist==0 then return 0 end
        if Toggles.Music_Shuffle and Toggles.Music_Shuffle.Value and #playlist>1 then local pick=currentIndex; while pick==currentIndex do pick=math.random(1,#playlist) end; return pick end
        return ((currentIndex-1+step)%#playlist)+1
    end
 
    local playBtn=PlayerBox:AddButton({Text="Play",Func=function() playTrack(selectedIndex()) end})
    playBtn:AddButton({Text="Pause / Resume",Func=function() if sound.IsPaused then sound:Resume() elseif sound.IsPlaying then sound:Pause() end end})
    local prevBtn2=PlayerBox:AddButton({Text="Previous",Func=function() playTrack(nextIndex(-1)) end})
    prevBtn2:AddButton({Text="Next",Func=function() playTrack(nextIndex(1)) end})
    PlayerBox:AddButton({Text="Stop",Func=function() playToken+=1; sound:Stop(); setStatus("Now Playing: nothing") end})
    PlayerBox:AddLabel({Text="Only you can hear this music.",DoesWrap=true})
 
    ControlBox:AddSlider("Music_Volume",{Text="Volume",Min=0,Max=100,Default=50,Rounding=0,Suffix="%",Callback=function(v) sound.Volume=v/100 end})
    ControlBox:AddSlider("Music_Speed", {Text="Speed", Min=50,Max=200,Default=100,Rounding=0,Suffix="%",Callback=function(v) sound.PlaybackSpeed=v/100 end})
    ControlBox:AddToggle("Music_Loop",    {Text="Loop Track",    Default=false,Callback=function(v) sound.Looped=v end})
    ControlBox:AddToggle("Music_Shuffle", {Text="Shuffle",       Default=false})
    ControlBox:AddToggle("Music_AutoNext",{Text="Auto Play Next",Default=true})
    connect(sound.Ended,function() if Toggles.Music_AutoNext.Value then playTrack(nextIndex(1)) else setStatus("Finished") end end)
 
    local function fmtTime(s) return ("%d:%02d"):format(math.floor(s/60),math.floor(s%60)) end
    task.spawn(function()
        while not unloaded do
            local track=playlist[currentIndex]
            if track and sound.IsLoaded and sound.TimeLength>0 and (sound.IsPlaying or sound.IsPaused) then
                local prefix=sound.IsPaused and "Paused: " or "Now Playing: "
                setStatus(prefix..track.name.." ("..fmtTime(sound.TimePosition).." / "..fmtTime(sound.TimeLength)..")")
            end
            task.wait(0.5)
        end
    end)
 
    PlaylistBox:AddInput("Music_CustomId",{Text="Custom Audio ID",Default="",Numeric=false,Finished=false,Placeholder="Roblox audio ID"})
    PlaylistBox:AddButton({Text="Add To Playlist",Func=function()
        local id=tostring(Options.Music_CustomId.Value or ""):gsub("%D",""); if id=="" then Library:Notify("Paste an audio ID first",3); return end
        table.insert(playlist,{name="Custom "..id,ids={id}}); refreshDropdown(); Library:Notify("Added Custom "..id,3)
    end})
    onCleanup(function() playToken+=1; sound:Destroy() end)
end
 
